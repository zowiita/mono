<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MÖNO — Log every anime. Review every season.</title>
  <meta name="description" content="Log every anime. Review every season. Share your taste. The social archive for anime cinephiles.">
  
  <!-- Satoshi Font exclusively -->
  <link href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,700,800,900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/mono-brand.css">

  <style>
    /* =============================================================
       MÖNO LANDING PAGE — LETTERBOXD-EXACT CINEMATIC HERO
       ============================================================= */

    :root {
      --lb-bg: #14181C;
      --lb-card: #1C2228;
      --lb-card-border: rgba(255, 255, 255, 0.08);
      --mono-orange: #FF5500;
      --mono-cobalt: #1D00FF;
    }

    body {
      background-color: var(--lb-bg);
      color: #FFFFFF;
      font-family: 'Satoshi', sans-serif;
      overflow-x: hidden;
      margin: 0;
      padding: 0;
    }

    /* =============================================================
       TRANSPARENT NAVBAR OVER HERO (LETTERBOXD STYLE)
       ============================================================= */
    .mono-nav-letterboxd {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      z-index: 50;
      padding: 22px 0;
      background: linear-gradient(to bottom, rgba(20, 24, 28, 0.9) 0%, rgba(20, 24, 28, 0.4) 60%, transparent 100%);
    }

    .mono-nav-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .mono-brand-logo-lb {
      display: inline-flex;
      align-items: center;
      text-decoration: none;
      transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .mono-brand-logo-lb:hover {
      transform: scale(1.04);
    }
    .mono-brand-logo-lb img {
      height: 36px;
      width: auto;
      filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.8));
    }

    .mono-nav-menu {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    .mono-nav-item {
      color: #8C98A4;
      font-size: 12px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      text-decoration: none;
      transition: color 0.15s ease;
    }
    .mono-nav-item:hover {
      color: #FFFFFF;
    }

    .mono-nav-search {
      position: relative;
      margin-left: 8px;
    }
    .mono-nav-search input {
      background: rgba(255, 255, 255, 0.12);
      border: 1px solid rgba(255, 255, 255, 0.18);
      border-radius: 99px;
      padding: 6px 14px 6px 30px;
      color: #FFFFFF;
      font-size: 12px;
      font-family: inherit;
      width: 140px;
      transition: all 0.2s;
    }
    .mono-nav-search input:focus {
      background: rgba(255, 255, 255, 0.2);
      width: 180px;
      outline: none;
      border-color: var(--mono-orange);
    }
    .mono-nav-search svg {
      position: absolute;
      left: 10px;
      top: 50%;
      transform: translateY(-50%);
      color: #8C98A4;
      pointer-events: none;
    }

    /* =============================================================
       HERO BANNER (SUBTLE LETTERBOXD FADE WITH TEXT DIRECTLY ON TOP)
       ============================================================= */
    .hero-cinematic-stage {
      position: relative;
      width: 100%;
      min-height: 620px;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      align-items: center;
      padding-bottom: 72px;
      overflow: hidden;
      background-color: var(--lb-bg);
    }

    /* Backdrop Image Layer */
    .hero-backdrop-container {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .hero-backdrop-img {
      width: 100%;
      max-width: 1300px;
      height: 100%;
      object-fit: cover;
      object-position: center 25%;
      /* Exact Letterboxd radial & linear vignette mask */
      mask-image: radial-gradient(
        ellipse 90% 70% at 50% 42%,
        black 40%,
        rgba(0, 0, 0, 0.85) 60%,
        rgba(0, 0, 0, 0.3) 80%,
        transparent 98%
      ),
      linear-gradient(
        to bottom,
        rgba(0,0,0,0.6) 0%,
        black 20%,
        black 65%,
        transparent 100%
      );
      -webkit-mask-image: radial-gradient(
        ellipse 90% 70% at 50% 42%,
        black 40%,
        rgba(0, 0, 0, 0.85) 60%,
        rgba(0, 0, 0, 0.3) 80%,
        transparent 98%
      ),
      linear-gradient(
        to bottom,
        rgba(0,0,0,0.6) 0%,
        black 20%,
        black 65%,
        transparent 100%
      );
      mask-composite: intersect;
      -webkit-mask-composite: source-in;
    }

    /* Center Letterboxd Headline & Button (Direct on Image) */
    .hero-center-direct {
      position: relative;
      z-index: 10;
      text-align: center;
      max-width: 820px;
      margin: 0 auto;
      padding: 0 20px;
    }

    .letterboxd-h1 {
      font-size: clamp(34px, 4.2vw, 52px);
      font-weight: 900;
      line-height: 1.18;
      letter-spacing: -1.2px;
      color: #FFFFFF;
      margin: 0 0 28px 0;
      text-shadow: 0 3px 18px rgba(0, 0, 0, 0.8), 0 1px 4px rgba(0, 0, 0, 0.9);
    }

    .letterboxd-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: var(--mono-orange);
      color: #FFFFFF;
      font-size: 16px;
      font-weight: 800;
      padding: 14px 38px;
      border-radius: var(--r-full);
      text-decoration: none;
      box-shadow: 0 8px 26px rgba(255, 85, 0, 0.38), 0 2px 6px rgba(0, 0, 0, 0.5);
      border: 1px solid rgba(255, 255, 255, 0.2);
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .letterboxd-btn:hover {
      background: #E54B00;
      transform: translateY(-2px);
      box-shadow: 0 12px 32px rgba(255, 85, 0, 0.55);
    }

    /* =============================================================
       TRENDING 6 ANIME SECTION (WITH CIRCULAR MÖNO BADGES)
       ============================================================= */
    .trending-showcase-section {
      padding: 16px 0 72px;
      background: var(--lb-bg);
      position: relative;
      z-index: 10;
    }

    .trending-eyebrow-container {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      margin-bottom: 26px;
    }

    .mono-circle-badge-img {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      display: inline-block;
      vertical-align: middle;
      box-shadow: 0 2px 8px rgba(255, 85, 0, 0.4);
      transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .trending-eyebrow-container:hover .mono-circle-badge-img {
      transform: rotate(25deg) scale(1.15);
    }

    .trending-eyebrow-text {
      font-size: 13px;
      font-weight: 800;
      color: #9AB;
      letter-spacing: 0.3px;
      text-transform: uppercase;
      text-align: center;
    }

    .trending-grid-6 {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 16px;
      max-width: 1120px;
      margin: 0 auto;
    }

    .trending-item-card {
      text-decoration: none;
      display: flex;
      flex-direction: column;
      transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .trending-item-card:hover {
      transform: translateY(-6px);
    }

    .trending-poster-box {
      position: relative;
      border-radius: 8px;
      overflow: hidden;
      background: #1C2228;
      border: 1.5px solid rgba(255, 255, 255, 0.1);
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.5);
      aspect-ratio: 2 / 3;
      margin-bottom: 10px;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .trending-item-card:hover .trending-poster-box {
      border-color: var(--mono-orange);
      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.7), 0 0 18px rgba(255, 85, 0, 0.35);
    }

    .trending-poster-box img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.3s ease;
    }
    .trending-item-card:hover .trending-poster-box img {
      transform: scale(1.06);
    }

    .trending-title-row {
      display: flex;
      align-items: flex-start;
      gap: 6px;
    }

    .airing-dot-blue {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #00A3FF;
      flex-shrink: 0;
      margin-top: 5px;
      box-shadow: 0 0 6px #00A3FF;
    }

    .trending-anime-title {
      font-size: 13px;
      font-weight: 800;
      color: #D8E0E8;
      line-height: 1.35;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      transition: color 0.15s;
    }
    .trending-item-card:hover .trending-anime-title {
      color: #FFFFFF;
    }

    /* =============================================================
       "MÖNO LETS YOU..." 6-PILLAR GRID (LETTERBOXD DARK)
       ============================================================= */
    .mono-lets-you-section {
      padding: 88px 0 96px;
      background: #101418;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .section-eyebrow {
      font-size: 12px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 1.8px;
      color: #717B85;
      margin-bottom: 24px;
    }

    .mono-six-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }

    .feature-box {
      background: #181D22;
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 16px;
      padding: 26px;
      display: flex;
      gap: 18px;
      align-items: flex-start;
      transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .feature-box:hover {
      background: #1F252C;
      border-color: var(--mono-orange);
      transform: translateY(-4px);
      box-shadow: 0 14px 30px -6px rgba(0, 0, 0, 0.6), 0 0 18px rgba(255, 85, 0, 0.2);
    }

    .feature-icon-wrap {
      width: 46px;
      height: 46px;
      border-radius: 12px;
      background: rgba(255, 85, 0, 0.12);
      border: 1px solid rgba(255, 85, 0, 0.25);
      color: var(--mono-orange);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      transition: all 0.2s ease;
    }
    .feature-box:hover .feature-icon-wrap {
      background: var(--mono-orange);
      color: #FFFFFF;
      transform: scale(1.08) rotate(4deg);
    }

    .feature-box-content h4 {
      font-size: 16px;
      font-weight: 800;
      color: #FFFFFF;
      margin-bottom: 6px;
      letter-spacing: -0.2px;
    }

    .feature-box-content p {
      font-size: 13px;
      color: #8C98A4;
      line-height: 1.55;
    }

    /* =============================================================
       CREATIVE SWEET SPOT & COMPARISON
       ============================================================= */
    .creative-comparison-wrap {
      padding: 96px 0;
      background: #14181C;
    }

    .comp-stage {
      display: grid;
      grid-template-columns: 1fr 1.25fr 1fr;
      gap: 20px;
      align-items: center;
      margin-top: 48px;
    }

    .stage-card {
      background: #181D22;
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 20px;
      padding: 28px;
    }

    .stage-card-mono {
      background: linear-gradient(135deg, #1C1838 0%, #141420 100%);
      color: #FFFFFF;
      border: 1.5px solid var(--mono-cobalt);
      box-shadow: 0 16px 40px rgba(29, 0, 255, 0.25);
      transform: scale(1.04);
      z-index: 2;
    }

    .live-rating-pulse-box {
      background: rgba(0, 0, 0, 0.4);
      border: 1px solid rgba(255, 85, 0, 0.3);
      border-radius: 12px;
      padding: 14px;
      margin-top: 18px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    /* =============================================================
       ALL-TIME TOP 50 ARCHIVE (5 COLS x 3 ROWS WITH FADE PAYWALL)
       ============================================================= */
    .top-archive-section {
      padding: 88px 0 100px;
      background: #101418;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      position: relative;
    }

    .top-anime-grid-5 {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 18px;
      position: relative;
    }

    .top-item-card {
      position: relative;
      border-radius: 10px;
      overflow: hidden;
      background: #181D22;
      border: 1.5px solid rgba(255, 255, 255, 0.08);
      transition: all 0.25s ease;
    }
    .top-item-card:hover {
      border-color: var(--mono-orange);
      transform: translateY(-4px);
    }
    .top-item-card img {
      width: 100%;
      aspect-ratio: 2 / 3;
      object-fit: cover;
      display: block;
    }
    .top-rank-badge {
      position: absolute;
      top: 8px;
      left: 8px;
      background: rgba(20, 24, 28, 0.85);
      backdrop-filter: blur(8px);
      color: #FFFFFF;
      font-size: 11px;
      font-weight: 900;
      padding: 3px 8px;
      border-radius: 6px;
      border: 1px solid rgba(255, 255, 255, 0.15);
    }
    .top-meta-info {
      padding: 10px 12px;
      background: #181D22;
    }
    .top-title-text {
      font-size: 13px;
      font-weight: 800;
      color: #FFFFFF;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      margin-bottom: 2px;
    }
    .top-score-text {
      font-size: 11px;
      font-weight: 800;
      color: var(--mono-orange);
    }

    /* Third row blur */
    .row-blur-11 { opacity: 0.7; }
    .row-blur-12 { opacity: 0.5; filter: blur(1px); }
    .row-blur-13 { opacity: 0.35; filter: blur(2px); }
    .row-blur-14 { opacity: 0.25; filter: blur(3px); }
    .row-blur-15 { opacity: 0.15; filter: blur(4px); }

    .top-fade-paywall-overlay {
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 280px;
      background: linear-gradient(to top, #101418 40%, rgba(16, 20, 24, 0.88) 75%, transparent 100%);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-end;
      padding-bottom: 32px;
      z-index: 10;
    }

    /* Ambient Scroll Physics */
    .ambient-physics-flow {
      position: relative;
      height: 360px;
      background: #14181C;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      overflow: hidden;
    }

    /* Responsive */
    @media (max-width: 960px) {
      .trending-grid-6 {
        grid-template-columns: repeat(3, 1fr);
      }
      .mono-six-grid {
        grid-template-columns: 1fr;
      }
      .comp-stage {
        grid-template-columns: 1fr;
      }
      .top-anime-grid-5 {
        grid-template-columns: repeat(2, 1fr);
      }
      .mono-nav-menu {
        display: none;
      }
    }
  </style>
</head>
<body>

  <!-- Film Grain -->
  <div class="mono-grain"></div>

  <!-- HERO SECTION WITH INTEGRATED TRANSPARENT NAVBAR (EXACT LETTERBOXD SETUP) -->
  <section class="hero-cinematic-stage">
    
    <!-- Transparent Navbar on top of the hero -->
    <header class="mono-nav-letterboxd">
      <div class="mono-container mono-nav-inner">
        
        <!-- Official MÖNO Logo -->
        <a href="/" class="mono-brand-logo-lb">
          <img src="/images/mono_logo.png" alt="MÖNO Logo" style="filter: brightness(0) invert(1);">
        </a>

        <!-- Navigation Menu Links -->
        <nav class="mono-nav-menu">
          <a href="/login" class="mono-nav-item">Sign In</a>
          <a href="/register" class="mono-nav-item">Create Account</a>
          <a href="/anime" class="mono-nav-item">Films</a>
          <a href="/lists" class="mono-nav-item">Lists</a>
          <a href="/top100" class="mono-nav-item">Top 100</a>
          <a href="/series" class="mono-nav-item">Series</a>
          
          <div class="mono-nav-search">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" placeholder="Search...">
          </div>
        </nav>

      </div>
    </header>

    <!-- Backdrop Image with Letterboxd Radial/Edge Vignette -->
    <div class="hero-backdrop-container">
      <img src="/images/eva_zine_header.png" alt="Hero Backdrop" class="hero-backdrop-img">
    </div>

    <!-- Center Direct Typography & CTA (Directly on Image) -->
    <div class="hero-center-direct">
      <h1 class="letterboxd-h1">
        Log every anime.<br>
        Review every season.<br>
        Share your taste.
      </h1>

      <a href="/register" class="letterboxd-btn">
        Create your account
      </a>
    </div>

  </section>

  <!-- 6 MOST POPULAR ANIME OF THE SEASON (WITH MÖNO CIRCLE BADGES) -->
  <section class="trending-showcase-section">
    <div class="mono-container">
      
      <!-- Eyebrow with the 2 MÖNO circle badges -->
      <div class="trending-eyebrow-container">
        <img src="/images/mono_icon_circle.png" class="mono-circle-badge-img" alt="MÖNO">
        <span class="trending-eyebrow-text">The 6 most watched anime across the platform right now</span>
        <img src="/images/mono_icon_circle.png" class="mono-circle-badge-img" alt="MÖNO">
      </div>

      <!-- 6 Trending Season Posters -->
      <div class="trending-grid-6">
        
        <!-- 1. ONE PIECE -->
        <a href="/anime/one-piece" class="trending-item-card">
          <div class="trending-poster-box">
            <img src="https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx21-ELSYx3yMPcKM.jpg" alt="ONE PIECE">
          </div>
          <div class="trending-title-row">
            <div class="airing-dot-blue"></div>
            <div class="trending-anime-title">ONE PIECE</div>
          </div>
        </a>

        <!-- 2. Mushoku Tensei Season 3 -->
        <a href="/anime/mushoku-tensei" class="trending-item-card">
          <div class="trending-poster-box">
            <img src="https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx178789-hNXjKFzUq7mk.jpg" alt="Mushoku Tensei">
          </div>
          <div class="trending-title-row">
            <div class="trending-anime-title">Mushoku Tensei: Jobless Reincarnation Season 3</div>
          </div>
        </a>

        <!-- 3. THE GHOST IN THE SHELL -->
        <a href="/anime/ghost-in-the-shell" class="trending-item-card">
          <div class="trending-poster-box">
            <img src="https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx177699-hnzc1CS5ZSM2.png" alt="THE GHOST IN THE SHELL">
          </div>
          <div class="trending-title-row">
            <div class="trending-anime-title">THE GHOST IN THE SHELL</div>
          </div>
        </a>

        <!-- 4. I Want to Love You Till Your Dying Day -->
        <a href="/anime/kimi-ga-shinu-made" class="trending-item-card">
          <div class="trending-poster-box">
            <img src="https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx187260-WW5RBa5NINRP.jpg" alt="I Want to Love You Till Your Dying Day">
          </div>
          <div class="trending-title-row">
            <div class="trending-anime-title">I Want to Love You Till Your Dying Day</div>
          </div>
        </a>

        <!-- 5. Young Ladies Don't Play Fighting Games -->
        <a href="/anime/taiari-deshita" class="trending-item-card">
          <div class="trending-poster-box">
            <img src="https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx128757-Iqc6hTjEYIz4.png" alt="Young Ladies Don't Play Fighting Games">
          </div>
          <div class="trending-title-row">
            <div class="trending-anime-title">Young Ladies Don't Play Fighting Games</div>
          </div>
        </a>

        <!-- 6. The Oblivious Saint Can't Contain Her Power -->
        <a href="/anime/oblivious-saint" class="trending-item-card">
          <div class="trending-poster-box">
            <img src="https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx196219-imvC0rbk4VzH.jpg" alt="The Oblivious Saint">
          </div>
          <div class="trending-title-row">
            <div class="trending-anime-title">The Oblivious Saint Can't Contain Her Power</div>
          </div>
        </a>

      </div>

    </div>
  </section>

  <!-- "MÖNO LETS YOU..." 6-PILLAR CORE FEATURE GRID -->
  <section class="mono-lets-you-section">
    <div class="mono-container">
      
      <div class="section-eyebrow">MÖNO LETS YOU...</div>

      <div class="mono-six-grid">
        
        <!-- 1. Eye Track -->
        <div class="feature-box">
          <div class="feature-icon-wrap">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          </div>
          <div class="feature-box-content">
            <h4>Track every series, film & OVA</h4>
            <p>Keep track of every anime you’ve ever completed, log current seasons without clutter, or just start logging fresh from the day you join.</p>
          </div>
        </div>

        <!-- 2. Heart Like -->
