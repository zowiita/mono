<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= list.title %> — Curated list by <%= list.username %></title>
<link href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,600,700,900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
<style>
:root {
  --bg-main: #14181C;
  --bg-surface: #181D22;
  --bg-card: #1C2228;
  --orange: #FF5500;
  --orange-hover: #E54B00;
  --ink: #FFFFFF;
  --muted: #8C98A4;
  --border-subtle: rgba(255, 255, 255, 0.08);
}

* { box-sizing: border-box; margin: 0; padding: 0; }
body {
  font-family: 'Satoshi', sans-serif;
  background-color: var(--bg-main);
  color: #FFFFFF;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.main-content {
  flex: 1;
  max-width: 1080px;
  width: 100%;
  margin: 0 auto;
  padding: 40px 24px;
}

/* List Header */
.list-header {
  border-bottom: 1px solid var(--border-subtle);
  padding-bottom: 28px;
  margin-bottom: 36px;
}

.list-creator-row {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 16px;
}

.creator-avatar {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  object-fit: cover;
  background: linear-gradient(135deg, #280DC2, #5030D8);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 13px;
  border: 1px solid rgba(255,255,255,0.15);
}

.creator-meta {
  font-size: 14px;
  color: var(--muted);
}

.creator-name {
  font-weight: 700;
  color: #FFFFFF;
  text-decoration: none;
  transition: color 0.2s;
}

.creator-name:hover {
  color: var(--orange);
}

.list-title {
  font-size: 34px;
  font-weight: 900;
  color: #FFFFFF;
  letter-spacing: -0.6px;
  margin-bottom: 12px;
  line-height: 1.25;
}

.list-desc {
  font-size: 15px;
  line-height: 1.65;
  color: #CAD2D9;
  max-width: 820px;
  white-space: pre-wrap;
  margin-bottom: 24px;
}

/* Action Bar */
.list-action-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
  padding-top: 18px;
  border-top: 1px solid var(--border-subtle);
}

.action-group {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}

.btn-action {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  color: #FFFFFF;
  padding: 8px 16px;
  border-radius: 9999px;
  font-size: 13px;
  font-weight: 700;
  font-family: inherit;
  cursor: pointer;
  text-decoration: none;
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}

.btn-action:hover {
  border-color: rgba(255,255,255,0.25);
  transform: translateY(-1px);
}

.btn-action.liked {
  background: rgba(255, 68, 85, 0.12);
  border-color: rgba(255, 68, 85, 0.4);
  color: #FF4455;
}

.btn-action.saved {
  background: rgba(255, 85, 0, 0.12);
  border-color: rgba(255, 85, 0, 0.4);
  color: var(--orange);
}

.btn-action-primary {
  background: var(--orange);
  border-color: var(--orange);
  color: #FFFFFF;
}

.btn-action-primary:hover {
  background: var(--orange-hover);
  border-color: var(--orange-hover);
}

.btn-danger {
  color: #FF5555;
}

.btn-danger:hover {
  border-color: rgba(255,85,85,0.4);
  background: rgba(255,85,85,0.1);
}

/* Anime Grid */
.list-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20px;
}

.list-section-title {
  font-size: 18px;
  font-weight: 800;
  color: #FFFFFF;
}

.list-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
  gap: 20px;
  margin-bottom: 48px;
}

.anime-card {
  position: relative;
  display: flex;
  flex-direction: column;
  text-decoration: none;
  color: inherit;
}

.anime-poster-wrap {
  position: relative;
  width: 100%;
  aspect-ratio: 2/3;
  border-radius: 8px;
  overflow: hidden;
  background: #181D22;
  border: 1px solid var(--border-subtle);
  box-shadow: 0 4px 16px rgba(0,0,0,0.4);
  transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
}

.anime-card:hover .anime-poster-wrap {
  transform: translateY(-4px);
  box-shadow: 0 10px 28px rgba(0,0,0,0.7);
  border-color: rgba(255,85,0,0.4);
}

.anime-poster {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.rank-badge {
  position: absolute;
  top: 8px;
  left: 8px;
  background: rgba(20,24,28,0.9);
  color: #fff;
  font-weight: 900;
  font-size: 11px;
  padding: 3px 8px;
  border-radius: 4px;
  border: 1px solid rgba(255,255,255,0.15);
  backdrop-filter: blur(4px);
}

.card-title {
  font-size: 13px;
  font-weight: 700;
  color: #FFFFFF;
  margin-top: 8px;
  line-height: 1.3;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-meta {
  font-size: 12px;
  color: var(--muted);
  margin-top: 3px;
  display: flex;
  justify-content: space-between;
}

.card-score {
  color: var(--orange);
  font-weight: 700;
}

/* Comments Section */
.comments-section {
  border-top: 1px solid var(--border-subtle);
  padding-top: 36px;
  max-width: 800px;
}

.comments-header {
  font-size: 20px;
  font-weight: 800;
  color: #FFFFFF;
  margin-bottom: 24px;
  display: flex;
  align-items: center;
  gap: 8px;
}

.comment-form {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 32px;
}

.comment-textarea {
  width: 100%;
  min-height: 90px;
  background: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  border-radius: 10px;
  padding: 14px;
  color: #FFFFFF;
  font-family: inherit;
  font-size: 14px;
  line-height: 1.5;
  resize: vertical;
  outline: none;
  transition: border-color 0.2s;
}

.comment-textarea:focus {
  border-color: var(--orange);
}

.comment-submit-row {
  display: flex;
  justify-content: flex-end;
}

.btn-post-comment {
  background: var(--orange);
  color: #fff;
  border: none;
  padding: 9px 20px;
  border-radius: 9999px;
  font-size: 13px;
  font-weight: 700;
  font-family: inherit;
  cursor: pointer;
  transition: all 0.2s;
}

.btn-post-comment:hover {
  background: var(--orange-hover);
  transform: translateY(-1px);
}

/* Comments List */
.comments-list {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.comment-item {
  display: flex;
  gap: 14px;
  padding: 16px;
  background: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  border-radius: 10px;
}

.comment-avatar {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  object-fit: cover;
  background: linear-gradient(135deg, #280DC2, #5030D8);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  font-weight: 700;
  flex-shrink: 0;
}

.comment-content {
  flex: 1;
}

.comment-author-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6px;
}

.comment-author {
  font-size: 13px;
  font-weight: 700;
  color: #FFFFFF;
  text-decoration: none;
}

.comment-author:hover {
  color: var(--orange);
}

.comment-time {
  font-size: 12px;
  color: var(--muted);
}

.comment-text {
  font-size: 14px;
  line-height: 1.5;
  color: #CAD2D9;
  white-space: pre-wrap;
}

.btn-delete-comment {
  background: transparent;
  border: none;
  color: var(--muted);
  font-size: 11px;
  font-weight: 700;
  cursor: pointer;
  padding: 2px 6px;
  margin-top: 6px;
  transition: color 0.2s;
}

.btn-delete-comment:hover {
  color: #FF5555;
}

/* Toast alert */
.toast-msg {
  position: fixed;
  bottom: 24px;
  right: 24px;
  background: #181D22;
  border: 1px solid var(--orange);
  color: #FFFFFF;
  padding: 12px 20px;
  border-radius: 8px;
  box-shadow: 0 8px 24px rgba(0,0,0,0.6);
  font-size: 14px;
  font-weight: 600;
  z-index: 1000;
  display: none;
}
</style>
</head>
<body>

<%- include('partials/nav') %>

<main class="main-content">
  <div class="list-header">
    
    <!-- Creator Meta -->
    <div class="list-creator-row">
      <a href="/u/<%= list.username %>">
        <% if (list.avatar_url) { %>
          <img src="<%= list.avatar_url %>" class="creator-avatar" alt="<%= list.username %>">
        <% } else { %>
          <div class="creator-avatar"><%= list.username.charAt(0).toUpperCase() %></div>
        <% } %>
      </a>
      <div class="creator-meta">
        List by <a href="/u/<%= list.username %>" class="creator-name"><%= list.username %></a> · 
        <span style="color:#FFFFFF; font-weight:700;"><%= list.items ? list.items.length : 0 %> anime</span>
        <% if (list.is_ranked) { %>
          · <span style="color:var(--orange); font-weight:700;">Ranked Collection</span>
        <% } %>
      </div>
    </div>

    <!-- Title and Description -->
    <h1 class="list-title"><%= list.title %></h1>
    <% if (list.description) { %>
      <p class="list-desc"><%= list.description %></p>
    <% } %>

    <!-- Action Bar -->
    <div class="list-action-bar">
      <div class="action-group">
        <!-- Like Button -->
        <button id="btn-like" class="btn-action <%= list.is_liked ? 'liked' : '' %>" onclick="toggleListLike(<%= list.id %>)">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="<%= list.is_liked ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          <span id="like-count-text"><%= list.like_count || 0 %> Likes</span>
        </button>

        <!-- Save / Bookmark Button -->
        <button id="btn-save" class="btn-action <%= list.is_saved ? 'saved' : '' %>" onclick="toggleListSave(<%= list.id %>)">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="<%= list.is_saved ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
          <span id="save-btn-text"><%= list.is_saved ? 'Saved' : 'Save to Favorites' %></span>
        </button>

        <!-- Clone Button -->
        <button class="btn-action" onclick="cloneList(<%= list.id %>)" title="Duplicate this list to your account">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          Clone List
        </button>

        <!-- Share Button -->
        <button class="btn-action" onclick="shareList()">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
          Share
        </button>
      </div>

      <% if (list.is_owner) { %>
        <div class="action-group">
          <button class="btn-action btn-danger" onclick="deleteList(<%= list.id %>)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
            Delete
          </button>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Anime Grid -->
  <div class="list-section-header">
    <div class="list-section-title">Anime in this list (<%= list.items ? list.items.length : 0 %>)</div>
  </div>

  <div class="list-grid">
    <% if (list.items && list.items.length > 0) { %>
      <% list.items.forEach((item, index) => { %>
        <a href="/anime/<%= item.slug %>" class="anime-card">
          <div class="anime-poster-wrap">
            <% if (list.is_ranked) { %>
              <div class="rank-badge">#<%= index + 1 %></div>
            <% } %>
            <img src="<%= item.cover_image %>" alt="<%= item.title %>" class="anime-poster" loading="lazy">
          </div>
          <div class="card-title"><%= item.title %></div>
          <div class="card-meta">
            <span><%= item.release_year || 'TV' %></span>
            <span class="card-score">★ <%= item.score ? item.score.toFixed(1) : '4.5' %></span>
          </div>
        </a>
      <% }); %>
    <% } else { %>
      <div style="grid-column: 1 / -1; padding: 48px; text-align: center; color: var(--muted); background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: 10px;">
        This list currently has no anime entries.
      </div>
    <% } %>
  </div>

  <!-- Comments Thread -->
  <div class="comments-section" id="comments">
    <div class="comments-header">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      <span>Comments (<span id="comments-count"><%= comments ? comments.length : 0 %></span>)</span>
    </div>

    <!-- Comment Input Form -->
    <form class="comment-form" onsubmit="postComment(event, <%= list.id %>)">
      <textarea class="comment-textarea" id="comment-input" placeholder="Leave a thought or recommendation on this list..." required></textarea>
      <div class="comment-submit-row">
        <button type="submit" class="btn-post-comment">Post Comment</button>
      </div>
    </form>

    <!-- Comments List -->
    <div class="comments-list" id="comments-container">
      <% if (comments && comments.length > 0) { %>
        <% comments.forEach(c => { %>
          <div class="comment-item" id="comment-<%= c.id %>">
            <a href="/u/<%= c.username %>">
              <% if (c.avatar_url) { %>
                <img src="<%= c.avatar_url %>" class="comment-avatar" alt="<%= c.username %>">
              <% } else { %>
                <div class="comment-avatar"><%= c.username.charAt(0).toUpperCase() %></div>
              <% } %>
            </a>
            <div class="comment-content">
              <div class="comment-author-row">
                <a href="/u/<%= c.username %>" class="comment-author"><%= c.username %></a>
                <span class="comment-time"><%= new Date(c.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
              </div>
              <p class="comment-text"><%= c.content %></p>
              <% if (locals.currentUserId && currentUserId === c.user_id) { %>
                <button class="btn-delete-comment" onclick="deleteComment(<%= list.id %>, <%= c.id %>)">Delete</button>
              <% } %>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <p id="no-comments-msg" style="color: var(--muted); font-size: 14px; text-align: center; padding: 20px 0;">No comments yet. Start the conversation!</p>
      <% } %>
    </div>
  </div>
</main>

<div class="toast-msg" id="toast"></div>

<%- include('partials/footer') %>

<script>
function showToast(msg) {
  const toast = document.getElementById('toast');
  toast.textContent = msg;
  toast.style.display = 'block';
  setTimeout(() => { toast.style.display = 'none'; }, 3000);
}

async function toggleListLike(listId) {
  try {
    const res = await fetch('/api/list/' + listId + '/like', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
    const data = await res.json();
    if (data.success) {
      const btn = document.getElementById('btn-like');
      const text = document.getElementById('like-count-text');
      if (data.liked) {
        btn.classList.add('liked');
        btn.querySelector('svg').setAttribute('fill', 'currentColor');
      } else {
        btn.classList.remove('liked');
        btn.querySelector('svg').setAttribute('fill', 'none');
      }
      text.textContent = data.likeCount + (data.likeCount === 1 ? ' Like' : ' Likes');
    }
  } catch (err) {
    console.error(err);
  }
}

async function toggleListSave(listId) {
  try {
    const res = await fetch('/api/list/' + listId + '/save', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
    const data = await res.json();
    if (data.success) {
      const btn = document.getElementById('btn-save');
      const text = document.getElementById('save-btn-text');
      if (data.saved) {
        btn.classList.add('saved');
        btn.querySelector('svg').setAttribute('fill', 'currentColor');
        text.textContent = 'Saved';
        showToast('List saved to your favorites!');
      } else {
        btn.classList.remove('saved');
        btn.querySelector('svg').setAttribute('fill', 'none');
        text.textContent = 'Save to Favorites';
        showToast('List removed from favorites.');
      }
    }
  } catch (err) {
    console.error(err);
  }
}

async function cloneList(listId) {
  if (!confirm('Would you like to clone this list to your personal lists?')) return;
  try {
    const res = await fetch('/api/list/' + listId + '/clone', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
    const data = await res.json();
    if (data.success && data.redirectUrl) {
      showToast('List cloned successfully! Redirecting...');
      setTimeout(() => { window.location.href = data.redirectUrl; }, 1000);
    }
  } catch (err) {
    console.error(err);
    alert('Failed to clone list. Please try again.');
  }
}

function shareList() {
  navigator.clipboard.writeText(window.location.href);
  showToast('Link copied to clipboard!');
}

async function deleteList(listId) {
  if (!confirm('Are you sure you want to delete this list? This cannot be undone.')) return;
  try {
    const res = await fetch('/api/list/' + listId, { method: 'DELETE' });
    const data = await res.json();
    if (data.success) {
      window.location.href = '/lists';
    }
  } catch (err) {
    console.error(err);
  }
}

async function postComment(e, listId) {
  e.preventDefault();
  const input = document.getElementById('comment-input');
  const content = input.value.trim();
  if (!content) return;

  try {
    const res = await fetch('/api/list/' + listId + '/comment', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ content })
    });
    const data = await res.json();
    if (data.success && data.comment) {
      input.value = '';
      const noMsg = document.getElementById('no-comments-msg');
      if (noMsg) noMsg.remove();

      const container = document.getElementById('comments-container');
      const item = document.createElement('div');
      item.className = 'comment-item';
      item.id = 'comment-' + data.comment.id;
      item.innerHTML = `
        <a href="/u/${data.comment.username}">
          ${data.comment.avatar_url ? `<img src="${data.comment.avatar_url}" class="comment-avatar">` : `<div class="comment-avatar">${data.comment.username.charAt(0).toUpperCase()}</div>`}
        </a>
        <div class="comment-content">
          <div class="comment-author-row">
            <a href="/u/${data.comment.username}" class="comment-author">${data.comment.username}</a>
            <span class="comment-time">Just now</span>
          </div>
          <p class="comment-text">${data.comment.content}</p>
          <button class="btn-delete-comment" onclick="deleteComment(${listId}, ${data.comment.id})">Delete</button>
        </div>
      `;
      container.prepend(item);

      const countEl = document.getElementById('comments-count');
      if (countEl) countEl.textContent = parseInt(countEl.textContent || '0', 10) + 1;
      showToast('Comment posted!');
    }
  } catch (err) {
    console.error(err);
  }
}

async function deleteComment(listId, commentId) {
  if (!confirm('Delete this comment?')) return;
  try {
    const res = await fetch('/api/list/' + listId + '/comment/' + commentId + '/delete', { method: 'POST' });
    const data = await res.json();
    if (data.success) {
      const el = document.getElementById('comment-' + commentId);
      if (el) el.remove();
      const countEl = document.getElementById('comments-count');
      if (countEl) {
        const cur = Math.max(parseInt(countEl.textContent || '1', 10) - 1, 0);
        countEl.textContent = cur;
      }
      showToast('Comment deleted.');
    }
  } catch (err) {
    console.error(err);
  }
}
</script>

</body>
</html>