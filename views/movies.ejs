<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
<meta name="referrer" content="no-referrer">
<title>Movies — Untitled</title>
<link href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,600,700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
<style>
.page-wrap { padding-top: 40px; padding-bottom: 80px; }

.header-section {
    display: flex; justify-content: space-between; align-items: flex-end;
    margin-bottom: 24px; border-bottom: 1px solid rgba(255,255,255,0.08); padding-bottom: 16px;
}
.header-title { font-size: 28px; font-weight: 800; color: #FFFFFF; line-height: 1.1; letter-spacing: -0.5px; }
.header-sub { font-size: 14px; color: var(--muted); margin-top: 4px; }

/* Filter Bar */
.filter-bar {
    display: flex; gap: 12px; margin-bottom: 32px; flex-wrap: wrap; align-items: center;
}
.filter-select {
    appearance: none; background: #181D22; border: 1px solid rgba(255,255,255,0.12);
    padding: 8px 32px 8px 14px; border-radius: 8px; font-family: 'Satoshi', sans-serif;
    font-size: 13px; font-weight: 600; color: #FFFFFF; cursor: pointer;
    background-image: url("data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2224%22%20height%3D%2224%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%23CAD2D9%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpolyline%20points%3D%226%209%2012%2015%2018%209%22%3E%3C%2Fpolyline%3E%3C%2Fsvg%3E");
    background-repeat: no-repeat; background-position: right 8px center; background-size: 14px;
    transition: border-color 0.15s;
}
.filter-select:hover { border-color: var(--orange); }

.grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
    gap: 20px;
    width: 100%;
}
.card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    width: 100%;
}
.card-poster-wrap {
    position: relative;
    aspect-ratio: 2/3;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(0,0,0,0.4);
    background: #181D22;
    border: 1px solid rgba(255,255,255,0.08);
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
}
.card:hover .card-poster-wrap {
    transform: translateY(-4px);
    box-shadow: 0 10px 28px rgba(0,0,0,0.6);
    border-color: rgba(255,85,0,0.4);
}
.card-poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}
.card-badge {
    position: absolute; top: 8px; right: 8px; background: rgba(20,24,28,0.85);
    color: #fff; font-size: 11px; font-weight: 700; padding: 2px 6px; border-radius: 4px;
    border: 1px solid rgba(255,255,255,0.12);
}
.card-duration {
    position: absolute; bottom: 8px; left: 8px; background: var(--orange);
    color: #fff; font-size: 11px; font-weight: 700; padding: 2px 6px; border-radius: 4px;
}
.card-title {
    font-size: 13px; font-weight: 700; color: #CAD2D9; margin-top: 8px;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; line-height: 1.3;
}
.card:hover .card-title { color: #FFFFFF; }
.card-meta {
    font-size: 12px; color: var(--muted); margin-top: 2px;
    display: flex; justify-content: space-between; align-items: center;
}
.card-rating { color: var(--orange); font-weight: 700; }
</style>
</head>
<body>
    <%- include('partials/nav') %>

    <div class="wrap page-wrap">
        <div class="header-section">
            <div>
                <h1 class="header-title">Movies</h1>
                <div class="header-sub">Explore feature-length anime movies and theatrical masterworks</div>
            </div>
            <div style="font-size:13px; font-weight:600; color:var(--muted);">
                Showing <strong><%= locals.items ? items.length : 0 %></strong> movies
            </div>
        </div>

        <div class="filter-bar">
            <!-- Genre Filter -->
            <select class="filter-select" id="genre-select" onchange="applyFilters()">
                <option value="">All Genres</option>
                <% if (locals.genres) { %>
                    <% genres.forEach(g => { %>
                        <option value="<%= g.slug %>" <%= locals.activeGenre === g.slug ? 'selected' : '' %>><%= g.name %></option>
                    <% }); %>
                <% } %>
            </select>

            <!-- Season Filter -->
            <select class="filter-select" id="season-select" onchange="applyFilters()">
                <option value="">All Seasons</option>
                <option value="winter" <%= (locals.activeSeason && locals.activeSeason.toLowerCase() === 'winter') ? 'selected' : '' %>>Winter</option>
                <option value="spring" <%= (locals.activeSeason && locals.activeSeason.toLowerCase() === 'spring') ? 'selected' : '' %>>Spring</option>
                <option value="summer" <%= (locals.activeSeason && locals.activeSeason.toLowerCase() === 'summer') ? 'selected' : '' %>>Summer</option>
                <option value="fall" <%= (locals.activeSeason && locals.activeSeason.toLowerCase() === 'fall') ? 'selected' : '' %>>Fall</option>
            </select>

            <!-- Year Filter (1940 - 2026) -->
            <select class="filter-select" id="year-select" onchange="applyFilters()">
                <option value="">All Years</option>
                <% for(let y = 2026; y >= 1940; y--) { %>
                    <option value="<%= y %>" <%= (locals.activeYear == y) ? 'selected' : '' %>><%= y %></option>
                <% } %>
            </select>

            <!-- Sort Filter -->
            <select class="filter-select" id="sort-select" onchange="applyFilters()">
                <option value="popular" <%= locals.activeSort === 'popular' ? 'selected' : '' %>>Most Popular</option>
                <option value="score" <%= locals.activeSort === 'score' ? 'selected' : '' %>>Highest Rated</option>
                <option value="recent" <%= locals.activeSort === 'recent' ? 'selected' : '' %>>Recently Released</option>
                <option value="title" <%= locals.activeSort === 'title' ? 'selected' : '' %>>Title (A-Z)</option>
            </select>
        </div>

        <script>
            function applyFilters() {
                const genre = document.getElementById('genre-select').value;
                const season = document.getElementById('season-select').value;
                const year = document.getElementById('year-select').value;
                const sort = document.getElementById('sort-select').value;
                const params = new URLSearchParams();
                if (genre) params.append('genre', genre);
                if (season) params.append('season', season);
                if (year) params.append('year', year);
                if (sort) params.append('sort', sort);
                window.location.href = '/movies' + (params.toString() ? '?' + params.toString() : '');
            }
        </script>

        <div class="grid">
            <% if (locals.items && items.length > 0) { %>
                <% items.forEach(anime => { %>
                    <a href="/anime/<%= anime.slug %>" class="card">
                        <div class="card-poster-wrap">
                            <img src="<%= anime.cover_image %>" class="card-poster" alt="<%= anime.title %>">
                            <span class="card-badge">★ <%= anime.score %></span>
                            <span class="card-duration">Movie</span>
                        </div>
                        <div class="card-title"><%= anime.title %></div>
                        <div class="card-meta">
                            <span><%= anime.release_year %> • <%= anime.studio %></span>
                            <span class="card-rating">★ <%= anime.score %></span>
                        </div>
                    </a>
                <% }); %>
            <% } else { %>
                <div style="grid-column: 1 / -1; padding: 40px; text-align: center; color: var(--muted); background: #181D22; border: 1px solid rgba(255,255,255,0.08); border-radius: 8px;">
                    No anime films found matching your filters.
                </div>
            <% } %>
        </div>
    </div>

    <%- include('partials/footer') %>
</body>
</html>