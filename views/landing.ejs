  <!-- AMBIENT SCROLL PHYSICS CANVAS -->
  <section class="ambient-physics-flow" id="physicsContainer">
    <canvas id="physicsCanvas" class="mono-physics-canvas"></canvas>
    <div style="position: absolute; top: 20px; left: 50%; transform: translateX(-50%); z-index: 5; pointer-events: none;">
      <span style="font-size: 11px; font-weight: 800; letter-spacing: 1.5px; text-transform: uppercase; color: rgba(255, 255, 255, 0.4);">✦ INTERACTIVE AMBIENT TOKENS — DRAG & FLING ANY BALL ✦</span>
    </div>
  </section>

  <!-- UNIFIED FOOTER -->
  <%- include('partials/footer') %>

  <!-- Scripts -->
  <script src="/js/mono-physics.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // Ambient Physics initialization
      if (typeof MonoPhysicsPlayground !== 'undefined') {
        const physics = new MonoPhysicsPlayground('physicsContainer', 'physicsCanvas');
      }

      // Intersection Observer for Cinematic Scroll Animations
      const observerOptions = {
        root: null,
        rootMargin: '0px',
        threshold: 0.15
      };

      const scrollObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, observerOptions);

      document.querySelectorAll('.reveal-on-scroll, .reveal-scale').forEach(el => {
        scrollObserver.observe(el);
      });
    });
  </script>

</body>
</html>