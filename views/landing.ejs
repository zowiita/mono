<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="referrer" content="no-referrer">
  <title>MÖNO — The Social Diary & Archive for Anime</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">
  
  <style>
    /* =============================================================
       LETTERBOXD CINEMATIC DARK PALETTE & TOKENS (#222224 / #14181C)
       ============================================================= */
    :root {
      --lb-bg: #222224;
      --lb-surface: #181D22;
      --lb-card-bg: #1B2026;
      --lb-border: rgba(255, 255, 255, 0.08);
      --lb-border-hover: rgba(255, 255, 255, 0.25);
      
      --mono-orange: #FF5500;
      --mono-orange-glow: rgba(255, 85, 0, 0.35);
      --mono-cobalt: #280DC2;
      --mono-cobalt-light: #4A35EE;
      
      --lb-text: #FFFFFF;
      --lb-muted: #8C98A4;
      --lb-subtle: #717B85;
      
      --r-sm: 6px;
      --r-md: 10px;
      --r-lg: 16px;
      --r-full: 9999px;
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
      background-color: var(--lb-bg);
      color: var(--lb-text);
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    }

    body {
      background-color: var(--lb-bg);
      color: var(--lb-text);
      line-height: 1.5;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
      position: relative;
    }

    /* Film Grain Texture */
    .mono-grain {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      pointer-events: none;
      z-index: 9999;
      opacity: 0.035;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
    }

    /* Cinematic Reveal Animations */
    .reveal-on-scroll {
      opacity: 0;
      transform: translateY(50px);
      transition: opacity 0.85s cubic-bezier(0.16, 1, 0.3, 1), transform 0.85s cubic-bezier(0.16, 1, 0.3, 1);
      will-change: opacity, transform;
    }
    .reveal-scale {
      opacity: 0;
      transform: translateY(30px) scale(0.95);
      transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
      will-change: opacity, transform;
    }
    .is-visible {
      opacity: 1 !important;
      transform: translateY(0) scale(1) !important;
    }

    /* Delay classes for staggered animations */
    .delay-1 { transition-delay: 0.1s; }
    .delay-2 { transition-delay: 0.2s; }
    .delay-3 { transition-delay: 0.3s; }

    .mono-container {
      width: 100%;
      max-width: 1140px;
      margin: 0 auto;
      padding: 0 24px;
    }

    /* =============================================================
       TRANSPARENT FLOATING NAVBAR OVER HERO
       ============================================================= */
    .mono-nav-letterboxd {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      z-index: 100;
      background: linear-gradient(to bottom, rgba(20, 24, 28, 0.92) 0%, rgba(20, 24, 28, 0.5) 70%, transparent 100%);
      padding: 16px 0;
    }

    .mono-nav-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .mono-brand-logo-lb {
      display: inline-flex;
      align-items: center;
      text-decoration: none;
      transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .mono-brand-logo-lb:hover {
      transform: scale(1.04);
    }
    .mono-brand-logo-lb img {
      height: 32px;
      width: auto;
      object-fit: contain;
      display: block;
    }

    .mono-nav-menu {
      display: flex;
      align-items: center;
      gap: 22px;
    }

    .mono-nav-item {
      font-size: 13.5px;
      font-weight: 700;
      color: #CAD2D9;
      text-decoration: none;
      letter-spacing: 0.2px;
      transition: color 0.15s ease;
    }
    .mono-nav-item:hover {
      color: #FFFFFF;
    }

    .mono-nav-item.highlight-link {
      background: rgba(255, 85, 0, 0.15);
      color: #FF7728;
      padding: 6px 14px;
      border-radius: var(--r-full);
      border: 1px solid rgba(255, 85, 0, 0.35);
      transition: all 0.2s ease;
    }
    .mono-nav-item.highlight-link:hover {
      background: var(--mono-orange);
      color: #FFFFFF;
      border-color: var(--mono-orange);
      box-shadow: 0 0 14px rgba(255, 85, 0, 0.4);
    }

    .mono-nav-search {
      position: relative;
      display: flex;
      align-items: center;
    }
    .mono-nav-search input {
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: var(--r-full);
      padding: 7px 14px 7px 32px;
      font-size: 12.5px;
      color: #FFFFFF;
      font-family: inherit;
      width: 140px;
      transition: all 0.2s;
    }
    .mono-nav-search input:focus {
      background: rgba(255, 255, 255, 0.16);
      width: 180px;
      outline: none;
      border-color: var(--mono-orange);
    }
    .mono-nav-search svg {
      position: absolute;
      left: 10px;
      top: 50%;
      transform: translateY(-50%);
      color: #8C98A4;
      pointer-events: none;
    }

    /* =============================================================
       HERO BANNER (LETTERBOXD FADE WITH TYPOGRAPHY DIRECTLY ON TOP)
       ============================================================= */
    .hero-cinematic-stage {
      position: relative;
      width: 100%;
      min-height: 640px;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      align-items: center;
      padding-bottom: 76px;
      overflow: hidden;
      background-color: var(--lb-bg);
    }

    /* Backdrop Image Layer with Letterboxd radial & linear vignette */
    .hero-backdrop-container {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .hero-backdrop-img {
      width: 100%;
      max-width: 1350px;
      height: 100%;
      object-fit: cover;
      object-position: center 25%;
      mask-image: radial-gradient(
        ellipse 90% 70% at 50% 42%,
        black 40%,
        rgba(0, 0, 0, 0.85) 60%,
        rgba(0, 0, 0, 0.3) 80%,
        transparent 98%
      ),
      linear-gradient(
        to bottom,
        rgba(0,0,0,0.6) 0%,
        black 20%,
        black 65%,
        transparent 100%
      );
      -webkit-mask-image: radial-gradient(
        ellipse 90% 70% at 50% 42%,
        black 40%,
        rgba(0, 0, 0, 0.85) 60%,
        rgba(0, 0, 0, 0.3) 80%,
        transparent 98%
      ),
      linear-gradient(
        to bottom,
        rgba(0,0,0,0.6) 0%,
        black 20%,
        black 65%,
        transparent 100%
      );
      mask-composite: intersect;
      -webkit-mask-composite: source-in;
    }

    /* Floating Animated Circles in Hero Stage */
    .hero-ambient-orb {
      position: absolute;
      border-radius: 50%;
      pointer-events: none;
      z-index: 2;
      filter: blur(45px);
      opacity: 0.28;
      animation: floatOrb 12s ease-in-out infinite alternate;
    }
    .orb-1 {
      width: 320px;
      height: 320px;
      background: radial-gradient(circle, #FF5500, transparent 70%);
      top: 15%;
      left: 10%;
    }
    .orb-2 {
      width: 380px;
      height: 380px;
      background: radial-gradient(circle, #280DC2, transparent 70%);
      top: 25%;
      right: 8%;
      animation-duration: 16s;
    }
    @keyframes floatOrb {
      0% { transform: translateY(0) scale(1); }
      50% { transform: translateY(-25px) scale(1.08); }
      100% { transform: translateY(15px) scale(0.95); }
    }

    /* Center Letterboxd Headline & Button */
    .hero-center-direct {
      position: relative;
      z-index: 10;
      text-align: center;
      max-width: 820px;
      margin: 0 auto;
      padding: 0 20px;
    }

    .letterboxd-h1 {
      font-size: clamp(36px, 4.4vw, 54px);
      font-weight: 900;
      line-height: 1.16;
      letter-spacing: -1.4px;
      color: #FFFFFF;
      margin: 0 0 28px 0;
      text-shadow: 0 3px 20px rgba(0, 0, 0, 0.85), 0 1px 4px rgba(0, 0, 0, 0.95);
    }

    .letterboxd-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: var(--mono-orange);
      color: #FFFFFF;
      font-size: 16px;
      font-weight: 800;
      padding: 15px 42px;
      border-radius: var(--r-full);
      text-decoration: none;
      box-shadow: 0 8px 28px rgba(255, 85, 0, 0.42), 0 2px 6px rgba(0, 0, 0, 0.5);
      border: 1px solid rgba(255, 255, 255, 0.2);
      transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .letterboxd-btn:hover {
      background: #E54B00;
      transform: translateY(-2px);
      box-shadow: 0 12px 34px rgba(255, 85, 0, 0.6);
    }

    /* =============================================================
       TRENDING 6 ANIME SECTION (WITH CIRCULAR MÖNO BADGES)
       ============================================================= */
    .trending-showcase-section {
      padding: 24px 0 76px;
      background: var(--lb-bg);
      position: relative;
      z-index: 10;
    }

    .trending-eyebrow-container {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      margin-bottom: 28px;
    }

    .mono-circle-badge-img {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      display: inline-block;
      vertical-align: middle;
      box-shadow: 0 2px 8px rgba(255, 85, 0, 0.4);
      transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .trending-eyebrow-container:hover .mono-circle-badge-img {
      transform: rotate(25deg) scale(1.15);
    }

    .trending-eyebrow-text {
      font-size: 13px;
      font-weight: 800;
      color: #9AB;
      letter-spacing: 0.3px;
      text-transform: uppercase;
      text-align: center;
    }

    .trending-grid-6 {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 16px;
      max-width: 1120px;
      margin: 0 auto;
    }

    .trending-item-card {
      text-decoration: none;
      display: flex;
      flex-direction: column;
      transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .trending-item-card:hover {
      transform: translateY(-6px);
    }

    .trending-poster-box {
      position: relative;
      border-radius: 8px;
      overflow: hidden;
      background: #1C2228;
      border: 1.5px solid rgba(255, 255, 255, 0.1);
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.5);
      aspect-ratio: 2 / 3;
      margin-bottom: 10px;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .trending-item-card:hover .trending-poster-box {
      border-color: var(--mono-orange);
      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.7), 0 0 18px rgba(255, 85, 0, 0.35);
    }

    .trending-poster-box img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.3s ease;
    }
    .trending-item-card:hover .trending-poster-box img {
      transform: scale(1.06);
    }

    .trending-title-row {
      display: flex;
      align-items: flex-start;
      gap: 6px;
    }

    .airing-dot-blue {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #00A3FF;
      flex-shrink: 0;
      margin-top: 5px;
      box-shadow: 0 0 6px #00A3FF;
    }

    .trending-anime-title {
      font-size: 13px;
      font-weight: 800;
      color: #D8E0E8;
      line-height: 1.35;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      transition: color 0.15s;
    }
    .trending-item-card:hover .trending-anime-title {
      color: #FFFFFF;
    }

    /* =============================================================
       "MÖNO LETS YOU..." BENTO GRID (REDESIGNED & CENTERED)
       ============================================================= */
    .mono-lets-you-section {
      padding: 100px 0 110px;
      background: #141416;
      border-top: 1px solid rgba(255, 255, 255, 0.04);
      border-bottom: 1px solid rgba(255, 255, 255, 0.04);
      position: relative;
    }
    .mono-lets-you-section::before {
      content: "";
      position: absolute;
      top: 0; left: 0; width: 100%; height: 100%;
      background: radial-gradient(ellipse at 50% -20%, rgba(255,85,0,0.06), transparent 60%);
      pointer-events: none;
    }

    .section-eyebrow-center {
      font-size: 13px;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 2px;
      color: var(--mono-orange);
      margin-bottom: 36px;
      text-align: center;
    }

    .mono-six-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      max-width: 1080px;
      margin: 0 auto;
    }

    .feature-box {
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: 24px;
      padding: 32px;
      display: flex;
      flex-direction: column;
      gap: 20px;
      align-items: center;
      text-align: center;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      position: relative;
      overflow: hidden;
      backdrop-filter: blur(12px);
    }
    .feature-box::after {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0; height: 100%;
      background: linear-gradient(180deg, rgba(255,255,255,0.03) 0%, transparent 100%);
      opacity: 0;
      transition: opacity 0.3s;
    }
    .feature-box:hover {
      background: rgba(255, 255, 255, 0.04);
      border-color: rgba(255, 85, 0, 0.3);
      transform: translateY(-8px) scale(1.02);
      box-shadow: 0 20px 40px rgba(0,0,0,0.6), 0 0 40px rgba(255, 85, 0, 0.1);
    }
    .feature-box:hover::after {
      opacity: 1;
    }

    .feature-icon-wrap {
      width: 54px;
      height: 54px;
      border-radius: 14px;
      background: rgba(255, 85, 0, 0.1);
      border: 1px solid rgba(255, 85, 0, 0.2);
      color: var(--mono-orange);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .feature-box:hover .feature-icon-wrap {
      background: var(--mono-orange);
      color: #FFFFFF;
      transform: scale(1.15) rotate(5deg);
      box-shadow: 0 10px 20px rgba(255, 85, 0, 0.4);
    }

    .section-eyebrow {
      font-size: 12px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 1.8px;
      color: #8C98A4;
      margin-bottom: 24px;
    }

    .mono-six-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .feature-box {
      background: #202024;
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 16px;
      padding: 28px;
      display: flex;
      gap: 18px;
      align-items: flex-start;
      transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .feature-box:hover {
      background: #26262B;
      border-color: var(--mono-orange);
      transform: translateY(-4px);
      box-shadow: 0 14px 30px -6px rgba(0, 0, 0, 0.6), 0 0 18px rgba(255, 85, 0, 0.2);
    }

    .feature-icon-wrap {
      width: 46px;
      height: 46px;
      border-radius: 12px;
      background: rgba(255, 85, 0, 0.12);
      border: 1px solid rgba(255, 85, 0, 0.25);
      color: var(--mono-orange);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      transition: all 0.2s ease;
    }
    .feature-box:hover .feature-icon-wrap {
      background: var(--mono-orange);
      color: #FFFFFF;
      transform: scale(1.08) rotate(4deg);
    }

    .feature-box-content h4 {
      font-size: 16px;
      font-weight: 800;
      color: #FFFFFF;
      margin-bottom: 6px;
      letter-spacing: -0.2px;
    }

    .feature-box-content p {
      font-size: 13px;
      color: #8C98A4;
      line-height: 1.55;
    }

    /* =============================================================
       CREATIVE SWEET SPOT & COMPARISON (REDESIGNED)
       ============================================================= */
    .creative-comparison-wrap {
      padding: 110px 0;
      background: #18181A;
      position: relative;
      overflow: hidden;
    }
    .creative-comparison-wrap::before {
      content: "";
      position: absolute;
      width: 600px;
      height: 600px;
      background: radial-gradient(circle, rgba(255,85,0,0.08), transparent 70%);
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      pointer-events: none;
    }

    .comp-stage {
      display: grid;
      grid-template-columns: 1fr 1.35fr 1fr;
      gap: 24px;
      align-items: stretch;
      margin-top: 54px;
    }

    .stage-card {
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.04);
      border-radius: 24px;
      padding: 32px 28px;
      position: relative;
      backdrop-filter: blur(10px);
      transition: transform 0.3s;
    }
    .stage-card:hover {
      transform: translateY(-5px);
    }

    .stage-card-mono {
      background: linear-gradient(145deg, rgba(30,30,34,0.95) 0%, rgba(20,20,24,0.95) 100%);
      border: 1.5px solid rgba(255, 85, 0, 0.4);
      box-shadow: 0 24px 60px rgba(0,0,0,0.8), 0 0 60px rgba(255,85,0,0.15);
      transform: scale(1.05);
      z-index: 2;
      padding: 40px 32px;
    }
    .stage-card-mono:hover {
      transform: scale(1.07);
    }

    .live-rating-pulse-box {
      background: rgba(0, 0, 0, 0.5);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 16px;
      padding: 18px 20px;
      margin-top: 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      backdrop-filter: blur(5px);
      box-shadow: inset 0 0 20px rgba(0,0,0,0.5);
    }

    /* =============================================================
       ALL-TIME TOP 50 ARCHIVE (5 COLS x 3 ROWS WITH FADE PAYWALL)
       ============================================================= */
    .top-archive-section {
      padding: 88px 0 100px;
      background: #18181A;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      position: relative;
    }

    .top-anime-grid-5 {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 18px;
      position: relative;
    }

    .top-item-card {
      position: relative;
      border-radius: 10px;
      overflow: hidden;
      background: #202024;
      border: 1.5px solid rgba(255, 255, 255, 0.08);
      transition: all 0.25s ease;
    }
    .top-item-card:hover {
      border-color: var(--mono-orange);
      transform: translateY(-4px);
    }
    .top-item-card img {
      width: 100%;
      aspect-ratio: 2 / 3;
      object-fit: cover;
      display: block;
    }
    .top-rank-badge {
      position: absolute;
      top: 8px;
      left: 8px;
      background: rgba(20, 24, 28, 0.85);
      backdrop-filter: blur(8px);
      color: #FFFFFF;
      font-size: 11px;
      font-weight: 900;
      padding: 3px 8px;
      border-radius: 6px;
      border: 1px solid rgba(255, 255, 255, 0.15);
    }
    .top-meta-info {
      padding: 10px 12px;
      background: #202024;
    }
    .top-title-text {
      font-size: 13px;
      font-weight: 800;
      color: #FFFFFF;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      margin-bottom: 2px;
    }
    .top-score-text {
      font-size: 11px;
      font-weight: 800;
      color: var(--mono-orange);
    }

    /* Third row progressive blur */
    .row-blur-11 { opacity: 0.7; }
    .row-blur-12 { opacity: 0.5; filter: blur(1px); }
    .row-blur-13 { opacity: 0.35; filter: blur(2px); }
    .row-blur-14 { opacity: 0.25; filter: blur(3px); }
    .row-blur-15 { opacity: 0.15; filter: blur(4px); }

    .top-fade-paywall-overlay {
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 280px;
      background: linear-gradient(to top, #18181A 40%, rgba(24, 24, 26, 0.88) 75%, transparent 100%);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-end;
      padding-bottom: 32px;
      z-index: 10;
    }

    /* Ambient Scroll Physics */
    .ambient-physics-flow {
      position: relative;
      height: 360px;
      background: #222224;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      overflow: hidden;
    }

    /* Responsive */
    @media (max-width: 960px) {
      .trending-grid-6 {
        grid-template-columns: repeat(3, 1fr);
      }
      .mono-six-grid {
