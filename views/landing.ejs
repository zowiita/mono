  <style>
  .sec-landing-cta {
      background: transparent !important; /* Same dark color as landing page background */
  }

  /* Background Animated Bubbles Container Across Full Section Width */
  .cta-bubble-bg {
      position: absolute;
      top: 0; left: 0; right: 0; bottom: 0;
      overflow: hidden;
      pointer-events: none;
      z-index: 1;
  }

  /* Solid Orange Circles / Bubbles with Full Opacity */
  .orange-bubble {
      position: absolute;
      border-radius: 50%;
      background: #E5386B;
      opacity: 1 !important;
      box-shadow: 0 14px 40px rgba(229, 56, 107, 0.55), inset 0 -4px 12px rgba(0, 0, 0, 0.25);
  }

  /* Bubble 1: Top Left Large (Fixed inside section padding so it never overflows top) */
  .orange-bubble.b1 {
      width: 130px;
      height: 130px;
      top: 40px;
      left: 4%;
      animation: floatMove1 7.5s ease-in-out infinite alternate;
  }

  /* Bubble 2: Bottom Right Huge */
  .orange-bubble.b2 {
      width: 160px;
      height: 160px;
      bottom: 20px;
      right: 5%;
      animation: floatMove2 9.5s ease-in-out infinite alternate;
  }

  /* Bubble 3: Top Right Medium */
  .orange-bubble.b3 {
      width: 95px;
      height: 95px;
      top: 50px;
      right: 9%;
      animation: floatMove3 6.5s ease-in-out infinite alternate;
  }

  /* Bubble 4: Bottom Left Medium */
  .orange-bubble.b4 {
      width: 105px;
      height: 105px;
      bottom: 30px;
      left: 8%;
      animation: floatMove4 8.5s ease-in-out infinite alternate;
  }

  /* Keyframe Animations for Living, Morphing & Floating Outer Orange Bubbles */
  @keyframes floatMove1 {
      0% { transform: translateY(0px) scale(1) rotate(0deg); }
      50% { transform: translateY(24px) scale(1.18) rotate(10deg); }
      100% { transform: translateY(-16px) scale(0.9) rotate(-10deg); }
  }

  @keyframes floatMove2 {
      0% { transform: translateY(0px) scale(1) rotate(0deg); }
      50% { transform: translateY(-28px) scale(1.2) rotate(-15deg); }
      100% { transform: translateY(20px) scale(0.92) rotate(15deg); }
  }

  @keyframes floatMove3 {
      0% { transform: translate(0, 0) scale(1); }
      50% { transform: translate(-20px, 28px) scale(1.22); }
      100% { transform: translate(16px, -16px) scale(0.85); }
  }

  @keyframes floatMove4 {
      0% { transform: translate(0, 0) scale(1); }
      50% { transform: translate(28px, -24px) scale(1.18); }
      100% { transform: translate(-16px, 16px) scale(0.88); }
  }

  /* Content Container Over Bubbles */
  .cta-content-inner {
      position: relative;
      z-index: 10;
      max-width: 720px;
      margin: 0 auto;
  }

  .cta-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 18px;
      border-radius: 20px;
      background: rgba(229, 56, 107, 0.12);
      border: 1px solid rgba(229, 56, 107, 0.3);
      color: #E5386B;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 1.2px;
      margin-bottom: 22px;
  }

  .cta-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #E5386B;
      box-shadow: 0 0 8px #E5386B;
      animation: blinkDot 1.5s ease-in-out infinite;
  }

  @keyframes blinkDot {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.4; transform: scale(0.7); }
  }

  .cta-headline {
      font-size: clamp(32px, 4.4vw, 46px);
      font-weight: 900;
      color: #FFFFFF;
      line-height: 1.2;
      margin: 0 0 18px 0;
      letter-spacing: -0.8px;
  }
  .cta-headline span {
      color: var(--mono-orange, #E5386B);
  }

  .cta-subtext {
      font-size: 16px;
      line-height: 1.65;
      color: #9E9E9E;
      margin: 0 0 34px 0;
  }

  .cta-actions {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 16px;
      flex-wrap: wrap;
  }

  .cta-btn-primary {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 15px 38px;
      border-radius: 30px;
      background: #E5386B;
      color: #FFFFFF;
      font-size: 15px;
      font-weight: 800;
      text-decoration: none;
      box-shadow: 0 10px 30px rgba(229, 56, 107, 0.5);
      transition: all 0.22s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .cta-btn-primary:hover {
      transform: translateY(-3px) scale(1.04);
      box-shadow: 0 14px 38px rgba(229, 56, 107, 0.7);
      background: #E54B00;
  }

  .cta-btn-secondary {
      display: inline-flex;
      align-items: center;
      padding: 15px 30px;
      border-radius: 30px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.15);
      color: #FFFFFF;
      font-size: 15px;
      font-weight: 700;
      text-decoration: none;
      transition: all 0.2s ease;
  }
  .cta-btn-secondary:hover {
      background: rgba(255, 255, 255, 0.12);
      transform: translateY(-2px);
  }
  </style>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // Ambient Physics initialization
      if (typeof MonoPhysicsPlayground !== 'undefined') {
        const physics = new MonoPhysicsPlayground('physicsContainer', 'physicsCanvas');
      }

      // Intersection Observer for Cinematic Scroll Animations
      const observerOptions = {
        root: null,
        rootMargin: '0px',
        threshold: 0.15
      };

      const scrollObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, observerOptions);

      document.querySelectorAll('.reveal-on-scroll, .reveal-scale').forEach(el => {
        scrollObserver.observe(el);
      });
    });
  </script>

</body>
