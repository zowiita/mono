<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title><%= profileUser.username %>'s Diary — Möno</title>
<link rel="preconnect" href="https://api.fontshare.com">
<link href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,600,700,800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
<style>
/* PROFILE HEADER & SUBNAV */
.ph { margin-bottom: 24px; }
.ph-banner {
    position: relative;
    width: 100%;
    height: 200px;
    border-radius: var(--r-md);
    overflow: hidden;
    background: #181D22;
    border: 1px solid rgba(255, 255, 255, 0.08);
}
.ph-banner-empty {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--muted);
    font-size: 13px;
    font-weight: 600;
}
.ph-main {
    display: flex;
    align-items: flex-end;
    gap: 20px;
    padding: 0 16px;
    margin-top: -50px;
    position: relative;
    z-index: 2;
    margin-bottom: 20px;
}
.ph-av {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    overflow: hidden;
    background: #252C34;
    border: 4px solid #14181C;
    box-shadow: 0 4px 14px rgba(0,0,0,0.5);
    flex-shrink: 0;
}
.ph-info { flex: 1; min-width: 0; padding-bottom: 4px; }
.ph-name { font-size: 24px; font-weight: 800; color: #FFFFFF; margin: 0 0 4px; letter-spacing: -0.4px; }
.ph-actions { padding-bottom: 6px; }
.ph-btn {
    padding: 7px 18px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    background: #1C2228;
    color: #CAD2D9;
    border: 1px solid rgba(255,255,255,0.12);
    text-decoration: none;
    transition: all 0.15s;
}
.ph-btn:hover { background: #252C34; color: #FFFFFF; border-color: rgba(255,255,255,0.25); }

/* SUBNAV TABS */
.pn {
    display: flex;
    align-items: center;
    gap: 4px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding-bottom: 0;
    margin-bottom: 20px;
    overflow-x: auto;
}
.pn a {
    padding: 10px 18px;
    font-size: 13.5px;
    font-weight: 700;
    color: var(--muted);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    transition: color 0.15s, border-color 0.15s;
    white-space: nowrap;
}
.pn a:hover { color: #FFFFFF; }
.pn a.active {
    color: #FFFFFF;
    border-bottom-color: var(--orange);
}

/* STATS ROW */
.st-row {
    display: flex;
    align-items: center;
    gap: 28px;
    padding: 14px 18px;
    background: #181D22;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--r-md);
    margin-bottom: 32px;
    overflow-x: auto;
}
.st-item { display: flex; flex-direction: column; }
.st-num { font-size: 18px; font-weight: 800; color: #FFFFFF; }
.st-lbl { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: var(--muted); }

/* DIARY TOOLBAR */
.diary-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}
.diary-title-area {
    display: flex;
    align-items: center;
    gap: 12px;
}
.diary-title-main {
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.3px;
    color: #FFFFFF;
    margin: 0;
    text-transform: uppercase;
}
.diary-count-pill {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    background: rgba(255, 85, 0, 0.12);
    color: var(--orange);
    border: 1px solid rgba(255, 85, 0, 0.25);
    padding: 3px 8px;
    border-radius: 4px;
}

/* FILTERS */
.diary-controls {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
}
.diary-year-pills {
    display: flex;
    align-items: center;
    gap: 6px;
}
.diary-pill {
    padding: 5px 12px;
    border-radius: 5px;
    font-size: 12px;
    font-weight: 700;
    color: var(--muted);
    text-decoration: none;
    background: #181D22;
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: all 0.15s;
}
.diary-pill:hover { color: #FFFFFF; border-color: rgba(255, 255, 255, 0.2); }
.diary-pill.active {
    color: #FFFFFF;
    background: #252C34;
    border-color: rgba(255, 255, 255, 0.25);
}

.diary-select {
    background: #181D22;
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #CAD2D9;
    font-family: inherit;
    font-size: 12px;
    font-weight: 600;
    padding: 6px 12px;
    border-radius: 5px;
    outline: none;
    cursor: pointer;
}
.diary-select:focus { border-color: var(--orange); }

.diary-search-input {
    background: #181D22;
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #FFFFFF;
    font-family: inherit;
    font-size: 12px;
    padding: 6px 12px;
    border-radius: 5px;
    outline: none;
    width: 140px;
    transition: width 0.2s, border-color 0.2s;
}
.diary-search-input:focus { width: 180px; border-color: var(--orange); }

/* DIARY MONTH TABLE */
.diary-month-block {
    margin-bottom: 36px;
}
.diary-month-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 2px solid rgba(255, 255, 255, 0.1);
    padding-bottom: 8px;
    margin-bottom: 8px;
}
.diary-month-name {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    color: #FFFFFF;
}
.diary-month-entries {
    font-size: 11.5px;
    font-weight: 600;
    color: var(--muted);
}

.diary-table {
    width: 100%;
    border-collapse: collapse;
}
.diary-table th {
    text-align: left;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: var(--muted);
    padding: 8px 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}
.diary-table td {
    padding: 10px 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    vertical-align: middle;
}
.diary-table tr:hover td {
    background: rgba(255, 255, 255, 0.02);
}

.col-day {
    font-size: 15px;
    font-weight: 800;
    color: #FFFFFF;
    width: 44px;
    text-align: center;
}
.col-poster {
    width: 44px;
    padding-right: 6px;
}
.diary-thumb {
    width: 38px;
    height: 54px;
    border-radius: 4px;
    overflow: hidden;
    background: #14181C;
    border: 1px solid rgba(255, 255, 255, 0.08);
    display: block;
    transition: transform 0.15s, border-color 0.15s;
}
.diary-thumb:hover {
    transform: scale(1.08);
    border-color: rgba(255, 255, 255, 0.3);
}
.diary-thumb img { width: 100%; height: 100%; object-fit: cover; }

.col-title {
    min-width: 180px;
}
.diary-anime-title {
    font-size: 14px;
    font-weight: 700;
    color: #FFFFFF;
    text-decoration: none;
    display: inline-block;
    transition: color 0.15s;
}
.diary-anime-title:hover { color: var(--orange); }
.diary-anime-year {
    font-size: 12px;
    color: var(--muted);
    margin-left: 6px;
}

.col-rating {
    width: 110px;
    white-space: nowrap;
}
.diary-stars {
    color: var(--orange);
    display: inline-flex;
    align-items: center;
    gap: 1px;
    font-size: 12px;
}
.diary-stars svg { width: 12px; height: 12px; fill: var(--orange); }

.col-like {
    width: 40px;
    text-align: center;
}
.diary-heart {
    color: var(--orange);
    display: inline-flex;
    align-items: center;
    justify-content: center;
}
.diary-heart svg { width: 13px; height: 13px; fill: var(--orange); }

.col-review {
    width: 44px;
    text-align: center;
}
.diary-rev-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.15s;
}
.diary-rev-btn:hover { color: var(--orange); }
.diary-rev-btn svg { width: 14px; height: 14px; }

.col-progress {
    width: 100px;
    text-align: right;
    white-space: nowrap;
}
.diary-prog-badge {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 2px 6px;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.05);
    color: var(--muted);
}
.diary-prog-completed {
    background: rgba(40, 194, 100, 0.15);
    color: #4ADE80;
    border: 1px solid rgba(74, 222, 128, 0.2);
}

/* EMPTY STATE */
.diary-empty {
    text-align: center;
    padding: 60px 20px;
    background: #181D22;
    border: 1px dashed rgba(255, 255, 255, 0.1);
    border-radius: var(--r-lg);
    margin-top: 20px;
}
.diary-empty svg {
    width: 44px;
    height: 44px;
    color: var(--muted);
    stroke-width: 1.5;
    margin-bottom: 14px;
}
.diary-empty h3 {
    font-size: 18px;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 6px;
}
.diary-empty p {
    font-size: 13.5px;
    color: var(--muted);
    max-width: 380px;
    margin: 0 auto 18px;
    line-height: 1.5;
}
</style>
</head>
<body>
<%- include('partials/nav') %>

<div class="wrap" style="max-width:1100px;padding-top:32px;">
    <!-- Profile Header -->
    <div class="ph">
        <div class="ph-banner">
            <% if (profileUser.banner_url) { %>
                <img src="<%= profileUser.banner_url %>" style="width:100%;height:100%;object-fit:cover;" alt="Header">
            <% } else { %>
                <span class="ph-banner-empty"><% if(user && user.id === profileUser.id){ %>+ Add header image in Settings<% } %></span>
            <% } %>
        </div>
        <div class="ph-main">
            <div class="ph-av">
                <% if (profileUser.avatar_url) { %>
                    <img src="<%= profileUser.avatar_url %>" style="width:100%;height:100%;object-fit:cover;" alt="<%= profileUser.username %>">
                <% } else { %>
                    <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:36px;color:#fff;font-weight:700;"><%= profileUser.username.charAt(0).toUpperCase() %></div>
                <% } %>
            </div>
            <div class="ph-info">
                <h1 class="ph-name"><%= profileUser.username %></h1>
            </div>
            <div class="ph-actions">
                <% if (user && user.id === profileUser.id) { %>
                    <a href="/settings" class="ph-btn">Edit profile</a>
                <% } else if (user) { %>
                    <button id="btn-follow" onclick="toggleFollow('<%= profileUser.username %>')" class="ph-btn" style="border-color:var(--orange);background:<%= stats.isFollowing ? '#fff' : 'var(--orange)' %>;color:<%= stats.isFollowing ? 'var(--orange)' : '#fff' %>;">
                        <%= stats.isFollowing ? '✓ Following' : '+ Follow' %>
                    </button>
                <% } %>
            </div>
        </div>

        <!-- Subnav Tabs -->
        <div class="pn">
            <a href="/u/<%= profileUser.username %>">Profile</a>
            <a href="/u/<%= profileUser.username %>/anime">Anime</a>
            <a href="/u/<%= profileUser.username %>/diary" class="active">Diary</a>
            <a href="/u/<%= profileUser.username %>/watchlist">Watchlist</a>
            <a href="/u/<%= profileUser.username %>/lists">Lists</a>
            <a href="/u/<%= profileUser.username %>/reviews">Reviews</a>
            <a href="/u/<%= profileUser.username %>/stats">Stats</a>
        </div>

        <!-- Stats Row -->
        <div class="st-row">
            <div class="st-item"><span class="st-num"><%= stats.watchedCount %></span><span class="st-lbl">Anime</span></div>
            <div class="st-item"><span class="st-num"><%= stats.totalEpisodes %></span><span class="st-lbl">Episodes</span></div>
            <div class="st-item"><span class="st-num"><%= stats.hoursWatched %>h</span><span class="st-lbl">Hours</span></div>
            <div class="st-item"><span class="st-num"><%= stats.followersCount %></span><span class="st-lbl">Followers</span></div>
            <div class="st-item"><span class="st-num"><%= stats.followingCount %></span><span class="st-lbl">Following</span></div>
        </div>
    </div>

    <!-- Diary Section -->
    <div class="diary-toolbar">
        <div class="diary-title-area">
            <h2 class="diary-title-main">Diary</h2>
            <span class="diary-count-pill"><%= totalEntries %> <%= totalEntries === 1 ? 'ENTRY' : 'ENTRIES' %></span>
        </div>

        <div class="diary-controls">
            <!-- Year Pills -->
            <div class="diary-year-pills">
                <a href="/u/<%= profileUser.username %>/diary" class="diary-pill <%= !activeYear ? 'active' : '' %>">All</a>
                <% (allYears || []).forEach(function(yr) { %>
                    <a href="/u/<%= profileUser.username %>/diary?year=<%= yr %>" class="diary-pill <%= activeYear === yr ? 'active' : '' %>"><%= yr %></a>
                <% }) %>
            </div>

            <!-- Sort dropdown -->
            <select class="diary-select" onchange="window.location.href='/u/<%= profileUser.username %>/diary?year=<%= activeYear %>&sort=' + this.value">
                <option value="date_desc" <%= activeSort === 'date_desc' ? 'selected' : '' %>>Newest First</option>
                <option value="date_asc" <%= activeSort === 'date_asc' ? 'selected' : '' %>>Oldest First</option>
                <option value="rating_desc" <%= activeSort === 'rating_desc' ? 'selected' : '' %>>Highest Rated</option>
                <option value="rating_asc" <%= activeSort === 'rating_asc' ? 'selected' : '' %>>Lowest Rated</option>
            </select>

            <!-- Search input -->
            <form action="/u/<%= profileUser.username %>/diary" method="GET" style="margin:0;">
                <% if(activeYear){ %><input type="hidden" name="year" value="<%= activeYear %>"><% } %>
                <input type="text" name="q" value="<%= searchQuery %>" placeholder="Filter title..." class="diary-search-input">
            </form>
        </div>
    </div>

    <% if (monthGroups && monthGroups.length > 0) { %>
        <% monthGroups.forEach(function(group) { %>
            <div class="diary-month-block">
                <div class="diary-month-head">
                    <span class="diary-month-name"><%= group.monthKey %></span>
                    <span class="diary-month-entries"><%= group.entries.length %> <%= group.entries.length === 1 ? 'entry' : 'entries' %></span>
                </div>

                <table class="diary-table">
                    <thead>
                        <tr>
                            <th class="col-day">Day</th>
                            <th colspan="2">Film / Series</th>
                            <th class="col-rating">Rating</th>
                            <th class="col-like">Like</th>
                            <th class="col-review">Review</th>
                            <th class="col-progress">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% group.entries.forEach(function(e) { %>
                            <tr>
                                <td class="col-day"><%= e.day %></td>
                                <td class="col-poster">
                                    <a href="/anime/<%= e.slug %>" class="diary-thumb">
                                        <img src="<%= e.cover_image %>" alt="<%= e.title %>">
                                    </a>
                                </td>
                                <td class="col-title">
                                    <a href="/anime/<%= e.slug %>" class="diary-anime-title"><%= e.title %></a>
                                    <span class="diary-anime-year"><%= e.release_year %></span>
                                </td>
                                <td class="col-rating">
                                    <% if (e.rating > 0) { %>
                                        <div class="diary-stars">
                                            <% for(let s = 1; s <= 5; s++) { %>
                                                <% if (e.rating >= s) { %>
                                                    <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                                                <% } else if (e.rating >= s - 0.5) { %>
                                                    <svg viewBox="0 0 24 24"><path d="M12 2v15.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                                                <% } %>
                                            <% } %>
                                        </div>
                                    <% } else { %>
                                        <span style="color:var(--muted);font-size:12px;">—</span>
                                    <% } %>
                                </td>
                                <td class="col-like">
                                    <% if (e.is_liked) { %>
                                        <span class="diary-heart" title="Liked">
                                            <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                                        </span>
                                    <% } %>
                                </td>
                                <td class="col-review">
                                    <% if (e.hasReview) { %>
                                        <a href="/review/<%= e.log_id %>" class="diary-rev-btn" title="Read review">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                                        </a>
                                    <% } %>
                                </td>
                                <td class="col-progress">
                                    <% if (e.progress_status === 'completed') { %>
                                        <span class="diary-prog-badge diary-prog-completed">Completed</span>
                                    <% } else if (e.current_episode > 0) { %>
                                        <span class="diary-prog-badge">Ep <%= e.current_episode %><%= e.episodes_count ? '/' + e.episodes_count : '' %></span>
                                    <% } else if (e.type === 'movie') { %>
                                        <span class="diary-prog-badge">Film</span>
                                    <% } else { %>
                                        <span class="diary-prog-badge">Logged</span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% }) %>
    <% } else { %>
        <div class="diary-empty">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            <h3>No entries logged in diary</h3>
            <p>Entries appear automatically here whenever an anime is watched, rated, or logged with a date.</p>
        </div>
    <% } %>
</div>

<%- include('partials/footer') %>

<script>
async function toggleFollow(username) {
    const btn = document.getElementById('btn-follow');
    try {
        const res = await fetch('/api/user/' + username + '/follow', { method: 'POST' });
        const data = await res.json();
        if (data.success) {
            btn.textContent = data.isFollowing ? '✓ Following' : '+ Follow';
            btn.style.background = data.isFollowing ? '#fff' : 'var(--orange)';
            btn.style.color = data.isFollowing ? 'var(--orange)' : '#fff';
            const cnt = document.getElementById('followers-cnt');
            if (cnt) cnt.textContent = data.followersCount;
        }
    } catch(err) {
        console.error('Follow toggle error:', err);
    }
}
</script>
</body>
</html>
