<script>
// UNIVERSAL LOGGING MODAL LOGIC
let uniSelectedAnime = null;
let uniRating = 0;
let uniStatus = 'completed';
let uniCurrentEp = 1;
let uniTotalEps = 24;

function handleNavLog() {
    // If we're already on anime-detail page with its own log modal, trigger it
    const localModal = document.getElementById('log-modal');
    if (localModal) {
        localModal.style.display = 'flex';
        return;
    }

    // Otherwise open the universal Log Modal
    openUniversalLog();
}

function openUniversalLog() {
    const modal = document.getElementById('universal-log-modal');
    if (!modal) return;
    modal.classList.add('open');
    backToLogSearch();
    document.getElementById('uni-log-search-input')?.focus();
    searchAnimeForLog('');
}

function closeUniversalLog() {
    const modal = document.getElementById('universal-log-modal');
    if (modal) modal.classList.remove('open');
}

function closeUniversalLogOnBackdrop(e) {
    if (e.target.id === 'universal-log-modal') {
        closeUniversalLog();
    }
}

function backToLogSearch() {
    document.getElementById('uni-log-step-search').style.display = 'block';
    document.getElementById('uni-log-step-form').style.display = 'none';
    document.getElementById('uni-log-heading').innerText = 'Log Anime';
}

async function searchAnimeForLog(q) {
    const listEl = document.getElementById('uni-log-anime-list');
    if (!listEl) return;

    try {
        const res = await fetch(`/api/search/global?q=${encodeURIComponent(q)}`);
        const data = await res.json();
        
        if (!data.anime || data.anime.length === 0) {
            listEl.innerHTML = '<div style="padding:20px; text-align:center; color:var(--muted); font-size:13px;">No anime found.</div>';
            return;
        }

        let html = '';
        data.anime.forEach(a => {
            html += `
                <div onclick='selectAnimeForUniLog(${JSON.stringify(a).replace(/'/g, "&#39;")})' style="display:flex; align-items:center; gap:12px; padding:8px 12px; border-radius:6px; cursor:pointer; transition:background 0.15s;" onmouseover="this.style.background='var(--cream)'" onmouseout="this.style.background='transparent'">
                    <img src="${a.cover_image}" style="width:34px; height:48px; object-fit:cover; border-radius:4px; flex-shrink:0;">
                    <div style="flex:1; min-width:0;">
                        <div style="font-size:13px; font-weight:700; color:var(--ink); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">${a.title}</div>
                        <div style="font-size:11px; color:var(--muted);">${a.year || ''} • ${a.type || 'TV'} • ★ ${a.score || '—'}</div>
                    </div>
                    <span style="font-size:12px; font-weight:700; color:var(--blue);">Log &rarr;</span>
                </div>
            `;
        });
        listEl.innerHTML = html;
    } catch (err) {
        listEl.innerHTML = '<div style="padding:20px; text-align:center; color:var(--muted); font-size:13px;">Error fetching anime.</div>';
    }
}

function selectAnimeForUniLog(anime) {
    uniSelectedAnime = anime;
    document.getElementById('uni-log-heading').innerText = `Log: ${anime.title}`;
    document.getElementById('uni-log-poster').src = anime.cover_image;
    document.getElementById('uni-log-title').innerText = anime.title;
    document.getElementById('uni-log-meta').innerText = `${anime.year || ''} • ${anime.type || 'TV'} • ${anime.studio || ''}`;
    
    uniTotalEps = anime.episodes_count || 24;
    uniCurrentEp = 1;
    document.getElementById('uni-ep-total').innerText = uniTotalEps;
    document.getElementById('uni-ep-current').innerText = uniCurrentEp;

    // Reset Form
    uniRating = 0;
    resetUniRating();
    setUniStatus('completed', document.querySelector('.uni-status-btn[data-status="completed"]'));
    document.getElementById('uni-log-review').value = '';
    document.getElementById('uni-log-spoiler').checked = false;
    document.getElementById('uni-log-favorite').checked = false;

    document.getElementById('uni-log-step-search').style.display = 'none';
    document.getElementById('uni-log-step-form').style.display = 'block';
}

function setUniStatus(status, btn) {
    uniStatus = status;
    document.querySelectorAll('.uni-status-btn').forEach(b => b.classList.remove('active'));
    if (btn) btn.classList.add('active');

    const epWrap = document.getElementById('uni-ep-wrap');
    if (epWrap) {
        epWrap.style.display = status === 'watching' ? 'block' : 'none';
    }
}

function adjustUniEp(delta) {
    uniCurrentEp += delta;
    if (uniCurrentEp < 1) uniCurrentEp = 1;
    if (uniCurrentEp > uniTotalEps) uniCurrentEp = uniTotalEps;
    document.getElementById('uni-ep-current').innerText = uniCurrentEp;
}

function setUniRating(r) {
    uniRating = (uniRating === r) ? 0 : r;
    renderUniStars(uniRating);
}

function hoverUniRating(r) {
    renderUniStars(r);
}

function resetUniRating() {
    renderUniStars(uniRating);
}

function clearUniRating() {
    uniRating = 0;
    renderUniStars(0);
}

function renderUniStars(val) {
    const label = document.getElementById('uni-rating-label');
    const clearBtn = document.getElementById('uni-rating-clear-btn');
    
    for (let s = 1; s <= 5; s++) {
        const fill = document.getElementById('uni-star-fill-' + s);
        if (!fill) continue;
        
        if (val >= s) {
            fill.style.clipPath = 'inset(0 0 0 0)';
        } else if (val === s - 0.5) {
            fill.style.clipPath = 'inset(0 50% 0 0)';
        } else {
            fill.style.clipPath = 'inset(0 100% 0 0)';
        }
    }

    if (val > 0) {
        if (label) {
            label.innerText = '★ ' + val.toFixed(1) + ' / 5.0';
            label.classList.remove('empty');
        }
        if (clearBtn) clearBtn.style.display = 'inline-block';
    } else {
        if (label) {
            label.innerText = 'Sin calificar';
            label.classList.add('empty');
        }
        if (clearBtn) clearBtn.style.display = 'none';
    }
}

async function submitUniversalLog() {
    if (!uniSelectedAnime) return;
    
    const reviewText = document.getElementById('uni-log-review').value;
    const containsSpoilers = document.getElementById('uni-log-spoiler').checked;
    const isFavorite = document.getElementById('uni-log-favorite').checked;

    try {
        const res = await fetch(`/api/anime/${uniSelectedAnime.slug}/log`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                rating: uniRating,
                review: reviewText,
                status: uniStatus,
                current_episode: uniStatus === 'watching' ? uniCurrentEp : (uniStatus === 'completed' ? uniTotalEps : 0),
                contains_spoilers: containsSpoilers ? 1 : 0,
                is_favorite: isFavorite ? 1 : 0
            })
        });

        if (res.ok) {
            closeUniversalLog();
            // If on profile or anime page, reload to reflect entry
            if (window.location.pathname.startsWith('/u/') || window.location.pathname.startsWith('/anime/')) {
                window.location.reload();
            } else {
                alert(`Successfully logged "${uniSelectedAnime.title}"!`);
            }
        } else {
            alert('Failed to save log entry.');
        }
    } catch (err) {
        alert('Network error while saving log.');
    }
}

// GLOBAL COMMAND PALETTE SEARCH (ANIME ONLY, MAX 10, ENTER FOR FULL SEARCH)
let searchDebounceTimeout = null;

function openGlobalSearch() {
    const modal = document.getElementById('global-search-modal');
    const input = document.getElementById('global-search-input');
    if (!modal) return;
    modal.classList.add('open');
    input.value = '';
    input.focus();
    fetchGlobalSearchResults('');
}

function closeGlobalSearch() {
    const modal = document.getElementById('global-search-modal');
    if (modal) modal.classList.remove('open');
}

function closeGlobalSearchOnBackdrop(e) {
    if (e.target.id === 'global-search-modal') {
        closeGlobalSearch();
    }
}

function handleGlobalSearchSubmit(e) {
    const input = document.getElementById('global-search-input');
    if (!input || !input.value.trim()) {
        e.preventDefault();
        return false;
    }
    return true;
}

// Keyboard Shortcut listener (/) and (ESC)
window.addEventListener('keydown', (e) => {
    if (e.key === '/' && document.activeElement.tagName !== 'INPUT' && document.activeElement.tagName !== 'TEXTAREA') {
        e.preventDefault();
        openGlobalSearch();
    } else if (e.key === 'Escape') {
        closeGlobalSearch();
        closeUniversalLog();
        closeNotifications();
    }
});

document.getElementById('global-search-input')?.addEventListener('input', (e) => {
    clearTimeout(searchDebounceTimeout);
    const val = e.target.value;
    searchDebounceTimeout = setTimeout(() => {
        fetchGlobalSearchResults(val);
    }, 180);
});

async function fetchGlobalSearchResults(q) {
    const container = document.getElementById('global-search-results');
    if (!container) return;
    
    try {
        const res = await fetch(`/api/search/global?q=${encodeURIComponent(q)}`);
        const data = await res.json();
        
        let html = '';

        if (data.anime && data.anime.length > 0) {
            html += `<div class="search-category-title">Anime</div>`;
            data.anime.forEach(a => {
                html += `
                    <a href="/anime/${a.slug}" class="search-result-item">
                        <img src="${a.cover_image}" class="search-thumb">
                        <div class="search-item-info">
                            <div class="search-item-title">${a.title}</div>
                            <div class="search-item-sub">${a.year || ''} • ${a.type ? a.type.toUpperCase() : 'TV'} • ${a.studio || ''}</div>
                        </div>
                        <span class="search-score-badge">★ ${a.score ? a.score.toFixed(1) : '—'}</span>
                    </a>
                `;
            });

            if (q && q.trim()) {
                html += `
                    <a href="/search?q=${encodeURIComponent(q.trim())}" class="search-see-all-btn">
                        <span>Press Enter to see all results for "<strong>${q.trim()}</strong>"</span>
                        <span>&rarr;</span>
                    </a>
                `;
            }
        } else {
            html = `<div class="search-empty-state">No anime found for "${q}"</div>`;
        }

        container.innerHTML = html;
    } catch (err) {
        console.error(err);
        container.innerHTML = `<div class="search-empty-state">Error fetching search results.</div>`;
    }
}

// NOTIFICATIONS LOGIC
async function fetchNotificationsBadge() {
    try {
        const res = await fetch('/api/notifications');
        if (!res.ok) return;
        const data = await res.json();
        const badge = document.getElementById('nav-notif-badge');
        if (badge) {
            if (data.unreadCount > 0) {
                badge.innerText = data.unreadCount > 99 ? '99+' : data.unreadCount;
                badge.style.display = 'flex';
            } else {
                badge.style.display = 'none';
            }
        }
    } catch (e) {}
}

function toggleNotifications(e) {
    e.stopPropagation();
    const drop = document.getElementById('notif-dropdown');
    if (!drop) return;
    const isShowing = drop.style.display === 'flex';
    if (isShowing) {
        drop.style.display = 'none';
    } else {
        drop.style.display = 'flex';
        loadNotificationsList();
    }
}

function closeNotifications() {
    const drop = document.getElementById('notif-dropdown');
    if (drop) drop.style.display = 'none';
}

document.addEventListener('click', () => {
    closeNotifications();
});

async function loadNotificationsList() {
    const body = document.getElementById('notif-list-body');
    if (!body) return;
    body.innerHTML = '<div class="notif-loading">Loading...</div>';

    try {
        const res = await fetch('/api/notifications');
        const data = await res.json();
        
        if (!data.notifications || data.notifications.length === 0) {
            body.innerHTML = '<div class="notif-empty">No notifications yet.</div>';
            return;
        }

        let html = '';
        data.notifications.forEach(n => {
            let msg = '';
            let link = '#';
            if (n.type === 'follow') {
                msg = `<strong>${n.actor_username}</strong> started following you.`;
                link = `/u/${n.actor_username}`;
            } else if (n.type === 'like') {
                msg = `<strong>${n.actor_username}</strong> liked your review.`;
                link = `/review/${n.target_id}`;
            } else if (n.type === 'comment') {
                msg = `<strong>${n.actor_username}</strong> commented on your review.`;
                link = `/review/${n.target_id}`;
            }

            const av = n.actor_avatar ? `<img src="${n.actor_avatar}" class="notif-avatar">` : `<div class="notif-avatar">${n.actor_username.charAt(0).toUpperCase()}</div>`;
            const unreadClass = n.is_read === 0 ? 'unread' : '';

            html += `
                <a href="${link}" class="notif-item ${unreadClass}">
                    ${av}
                    <div class="notif-text">
                        <div>${msg}</div>
                        <div class="notif-time">${new Date(n.created_at).toLocaleDateString()}</div>
                    </div>
                </a>
            `;
        });
        body.innerHTML = html;
    } catch (err) {
        body.innerHTML = '<div class="notif-empty">Failed to load notifications.</div>';
    }
}

async function markAllNotificationsRead() {
    try {
        await fetch('/api/notifications/mark-read', { method: 'POST' });
        const badge = document.getElementById('nav-notif-badge');
        if (badge) badge.style.display = 'none';
        document.querySelectorAll('.notif-item.unread').forEach(el => el.classList.remove('unread'));
    } catch (e) {}
}

document.addEventListener('DOMContentLoaded', () => {
    fetchNotificationsBadge();
});
</script>
