    align-items: center;
    gap: 8px;
}
.rating-num-badge {
    font-size: 12px;
    font-weight: 700;
    color: var(--orange);
    background: rgba(255, 85, 0, 0.15);
    padding: 3px 8px;
    border-radius: 4px;
    min-width: 64px;
    text-align: center;
}
