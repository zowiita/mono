<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="referrer" content="no-referrer">
<title><%= locals.studioName || 'Studio' %> — Anime Catalog | MÖNO</title>
<link href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,600,700,900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
<style>
:root {
    --ink: #14181C;
    --muted: #8996A2;
    --cream: #F0EAE3;
    --cream-dk: #E4DDD5;
    --blue: #280DC2;
    --orange: #F37510;
    --white: #FDF8F4;
    --dark-bg: #14181C;
}

body {
    background: #14181C;
    color: #fff;
    font-family: 'Satoshi', -apple-system, BlinkMacSystemFont, sans-serif;
    margin: 0;
    padding: 0;
    min-height: 100vh;
}

.studio-wrap {
    max-width: 1140px;
    margin: 0 auto;
    padding: 40px 24px 80px;
}

.studio-header {
    border-bottom: 1px solid rgba(255,255,255,0.12);
    padding-bottom: 24px;
    margin-bottom: 24px;
}

.studio-pretitle {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 6px;
}

.studio-title {
    font-size: 38px;
    font-weight: 900;
    letter-spacing: -1px;
    color: #fff;
    margin: 0;
    line-height: 1.1;
}

/* FILTER TOOLBAR (Letterboxd Exact) */
.filter-bar {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 16px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 24px;
    flex-wrap: wrap;
}

.filter-select {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.12);
    color: #CCD6E0;
    padding: 6px 12px;
    border-radius: 4px;
    font-family: inherit;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    cursor: pointer;
    outline: none;
    transition: all 0.15s ease;
}

.filter-select:hover, .filter-select:focus {
    border-color: rgba(255,255,255,0.3);
    background: rgba(255,255,255,0.1);
    color: #fff;
}

/* POSTER GRID (6 Columns) */
.filmography-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 16px;
}

@media (max-width: 1024px) {
    .filmography-grid { grid-template-columns: repeat(4, 1fr); gap: 14px; }
}

@media (max-width: 640px) {
    .filmography-grid { grid-template-columns: repeat(3, 1fr); gap: 10px; }
    .studio-title { font-size: 28px; }
}

.film-card {
    position: relative;
    border-radius: 5px;
    overflow: hidden;
    aspect-ratio: 2/3;
    background: #202830;
    border: 1px solid rgba(255,255,255,0.08);
    display: block;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(0,0,0,0.4);
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
}

.film-card:hover {
    transform: translateY(-4px) scale(1.02);
    border-color: #F37510;
    box-shadow: 0 8px 24px rgba(243,117,16,0.25);
    z-index: 10;
}

.film-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.film-overlay {
    position: absolute;
    bottom: 0;
    inset-inline: 0;
    background: linear-gradient(transparent, rgba(20,24,28,0.95) 75%);
    padding: 16px 8px 8px;
    opacity: 0;
    transition: opacity 0.15s ease;
}

.film-card:hover .film-overlay {
    opacity: 1;
}

.film-name {
    font-size: 11px;
    font-weight: 700;
    color: #fff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: block;
}

.film-meta {
    font-size: 10px;
    color: #F37510;
    font-weight: 700;
    margin-top: 2px;
}

.empty-catalog {
    text-align: center;
    padding: 80px 20px;
    color: var(--muted);
}
</style>
</head>
<body>
    <%- include('partials/nav') %>

    <main class="studio-wrap">
        <header class="studio-header">
            <div class="studio-pretitle">Anime Produced by</div>
            <h1 class="studio-title"><%= studioName %></h1>
        </header>

        <!-- Filter Bar -->
        <div class="filter-bar">
            <label>
                Decade
                <select class="filter-select" onchange="applyStudioFilter('decade', this.value)">
                    <option value="">All Decades</option>
                    <option value="2020" <%= activeDecade === '2020' ? 'selected' : '' %>>2020s</option>
                    <option value="2010" <%= activeDecade === '2010' ? 'selected' : '' %>>2010s</option>
                    <option value="2000" <%= activeDecade === '2000' ? 'selected' : '' %>>2000s</option>
                    <option value="1990" <%= activeDecade === '1990' ? 'selected' : '' %>>1990s</option>
                    <option value="1980" <%= activeDecade === '1980' ? 'selected' : '' %>>1980s</option>
                </select>
            </label>

            <label>
                Genre
                <select class="filter-select" onchange="applyStudioFilter('genre', this.value)">
                    <option value="">All Genres</option>
                    <% if (locals.genres && genres.length > 0) { %>
                        <% genres.forEach(g => { %>
                            <option value="<%= g.slug %>" <%= activeGenre === g.slug ? 'selected' : '' %>><%= g.name %></option>
                        <% }); %>
                    <% } %>
                </select>
            </label>

            <label>
                Sort By
                <select class="filter-select" onchange="applyStudioFilter('sort', this.value)">
                    <option value="popular" <%= activeSort === 'popular' ? 'selected' : '' %>>Popularity</option>
                    <option value="score" <%= activeSort === 'score' ? 'selected' : '' %>>Highest Rated</option>
                    <option value="recent" <%= activeSort === 'recent' ? 'selected' : '' %>>Release Date</option>
                    <option value="title" <%= activeSort === 'title' ? 'selected' : '' %>>Film Title (A–Z)</option>
                </select>
            </label>
        </div>

        <!-- Filmography Grid -->
        <% if (locals.items && items.length > 0) { %>
            <div class="filmography-grid">
                <% items.forEach(anime => { %>
                    <a href="/anime/<%= anime.slug %>" class="film-card" title="<%= anime.title %> (<%= anime.release_year %>)">
                        <img src="<%= anime.cover_image %>" alt="<%= anime.title %>" class="film-img" loading="lazy" onerror="this.src='/images/frieren_cover_1785281175713.png'">
                        <div class="film-overlay">
                            <span class="film-name"><%= anime.title %></span>
                            <div class="film-meta">★ <%= anime.score ? anime.score.toFixed(1) : '4.5' %> • <%= anime.release_year %></div>
                        </div>
                    </a>
                <% }); %>
            </div>
        <% } else { %>
            <div class="empty-catalog">
                <p>No anime found matching your filter criteria for this studio.</p>
            </div>
        <% } %>
    </main>

    <script>
        function applyStudioFilter(key, val) {
            const url = new URL(window.location.href);
            if (val) {
                url.searchParams.set(key, val);
            } else {
                url.searchParams.delete(key);
            }
            window.location.href = url.toString();
        }
    </script>

    <%- include('partials/footer') %>
</body>
</html>
