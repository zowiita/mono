<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Community Lists — Untitled</title>
<link href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,600,700,900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
<style>
:root {
  --bg-main: #14181C;
  --bg-surface: #181D22;
  --bg-card: #1C2228;
  --orange: #FF5500;
  --orange-hover: #E54B00;
  --ink: #FFFFFF;
  --muted: #8C98A4;
  --border-subtle: rgba(255, 255, 255, 0.08);
}

* { box-sizing: border-box; margin: 0; padding: 0; }
body {
  font-family: 'Satoshi', sans-serif;
  background-color: var(--bg-main);
  color: #FFFFFF;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.main-content {
  flex: 1;
  max-width: 1200px;
  width: 100%;
  margin: 0 auto;
  padding: 40px 24px;
}

/* Header & Intro */
.header-banner {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  border-bottom: 1px solid var(--border-subtle);
  padding-bottom: 24px;
  margin-bottom: 28px;
  flex-wrap: wrap;
  gap: 16px;
}

.header-title-group h1 {
  font-size: 32px;
  font-weight: 900;
  letter-spacing: -0.8px;
  color: #FFFFFF;
  margin-bottom: 6px;
}

.header-title-group p {
  font-size: 15px;
  color: var(--muted);
  font-weight: 500;
}

.btn-create-list {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: var(--orange);
  color: #fff;
  padding: 10px 22px;
  border-radius: 9999px;
  font-weight: 700;
  font-size: 14px;
  text-decoration: none;
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: 0 4px 14px rgba(255, 85, 0, 0.35);
}

.btn-create-list:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(255, 85, 0, 0.5);
  background: var(--orange-hover);
}

/* Filter Toolbar */
.lists-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 32px;
  flex-wrap: wrap;
}

.lists-tabs {
  display: flex;
  align-items: center;
  gap: 20px;
}

.tab-link {
  font-size: 14px;
  font-weight: 700;
  color: var(--muted);
  text-decoration: none;
  padding: 8px 0;
  position: relative;
  transition: color 0.2s;
}

.tab-link:hover {
  color: #FFFFFF;
}

.tab-link.active {
  color: #FFFFFF;
}

.tab-link.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 2px;
  background: var(--orange);
  border-radius: 2px;
}

.search-box {
  position: relative;
  min-width: 260px;
  display: flex;
  align-items: center;
}

.search-input {
  width: 100%;
  background: #181D22;
  border: 1px solid var(--border-subtle);
  border-radius: 9999px;
  padding: 8px 16px 8px 38px !important;
  font-size: 13px;
  color: #FFFFFF;
  font-family: inherit;
  outline: none;
  box-sizing: border-box;
  line-height: normal;
  transition: border-color 0.2s;
}

.search-input:focus {
  border-color: var(--orange);
}

.search-icon {
  position: absolute;
  left: 14px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--muted);
  pointer-events: none;
  width: 14px;
  height: 14px;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Lists Grid */
.lists-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
  gap: 24px;
}

.list-card {
  background: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  display: flex;
  flex-direction: column;
  position: relative;
}

.list-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.7);
  border-color: rgba(255, 85, 0, 0.4);
}

/* Overlapping Covers Preview */
.list-covers-preview {
  height: 150px;
  background: #111418;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12px 20px;
  position: relative;
  overflow: hidden;
  text-decoration: none;
  border-bottom: 1px solid var(--border-subtle);
}

.covers-stack {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  width: 100%;
  height: 100%;
}

.cover-thumb {
  width: 78px;
  height: 114px;
  object-fit: cover;
  border-radius: 6px;
  box-shadow: -4px 0 14px rgba(0,0,0,0.6);
  border: 2px solid rgba(255,255,255,0.12);
  margin-left: -26px;
  transition: transform 0.2s, box-shadow 0.2s;
  background: #1C2228;
}

.cover-thumb:first-child {
  margin-left: 0;
}

.list-card:hover .cover-thumb {
  transform: translateY(-3px);
}

.list-card-body {
  padding: 20px;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.list-card-creator {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
}

.creator-info {
  display: flex;
  align-items: center;
  gap: 10px;
  text-decoration: none;
}

.creator-avatar {
  width: 26px;
  height: 26px;
  border-radius: 50%;
  object-fit: cover;
  background: linear-gradient(135deg, #280DC2, #5030D8);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 11px;
  font-weight: 700;
}

.creator-username {
  font-size: 13px;
  font-weight: 700;
  color: var(--muted);
  transition: color 0.2s;
}

.creator-info:hover .creator-username {
  color: var(--orange);
}

.list-card-title {
  font-size: 18px;
  font-weight: 800;
  line-height: 1.35;
  margin-bottom: 8px;
}

.list-card-title a {
  color: #FFFFFF;
  text-decoration: none;
  transition: color 0.2s;
}

.list-card-title a:hover {
  color: var(--orange);
}

.list-card-desc {
  font-size: 13px;
  line-height: 1.5;
  color: #CAD2D9;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 18px;
  flex: 1;
}

/* Card Social Footer */
.list-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1px solid var(--border-subtle);
  padding-top: 14px;
  font-size: 12px;
  font-weight: 700;
  color: var(--muted);
}

.card-badges {
  display: flex;
  align-items: center;
  gap: 8px;
}

.badge-items {
  color: var(--muted);
  font-size: 12px;
}

.badge-ranked {
  background: rgba(255,85,0,0.12);
  color: var(--orange);
  padding: 2px 8px;
  border-radius: 4px;
  font-size: 11px;
  font-weight: 700;
}

.card-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

.btn-card-action {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  background: transparent;
  border: none;
  color: var(--muted);
  cursor: pointer;
  font-size: 12px;
  font-weight: 700;
  font-family: inherit;
  transition: color 0.2s, transform 0.15s;
  padding: 4px 6px;
  border-radius: 4px;
}

.btn-card-action:hover {
  color: #FFFFFF;
  transform: scale(1.08);
}

.btn-card-action.liked {
  color: #FF4455;
}

.btn-card-action.saved {
  color: var(--orange);
}

.empty-state {
  text-align: center;
  padding: 80px 20px;
  color: var(--muted);
  background: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  border-radius: 12px;
}

@media (max-width: 768px) {
  .lists-grid { grid-template-columns: 1fr; }
  .lists-toolbar { flex-direction: column; align-items: stretch; }
  .search-box { width: 100%; }
}
</style>
</head>
<body>

<%- include('partials/nav') %>

<main class="main-content">
  <header class="header-banner">
    <div class="header-title-group">
      <h1>Community Lists</h1>
      <p>Discover themed rankings, curated marathons, and recommendations created by fans.</p>
    </div>
    <a href="/list/new" class="btn-create-list">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Create a List
    </a>
  </header>

  <!-- Toolbar with Tabs and Search -->
  <div class="lists-toolbar">
    <div class="lists-tabs">
      <a href="/lists?sort=popular<%= searchQuery ? '&q=' + encodeURIComponent(searchQuery) : '' %>" class="tab-link <%= activeSort === 'popular' ? 'active' : '' %>">Popular Lists</a>
      <a href="/lists?sort=recent<%= searchQuery ? '&q=' + encodeURIComponent(searchQuery) : '' %>" class="tab-link <%= activeSort === 'recent' ? 'active' : '' %>">Recent</a>
      <% if (currentUserId) { %>
        <a href="/lists?sort=saved" class="tab-link <%= activeSort === 'saved' ? 'active' : '' %>">Saved by Me</a>
      <% } %>
    </div>

    <form method="GET" action="/lists" class="search-box">
      <input type="hidden" name="sort" value="<%= activeSort %>">
      <svg class="search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input type="text" name="q" class="search-input" placeholder="Search lists or creators..." value="<%= searchQuery || '' %>">
    </form>
  </div>

  <% if (lists && lists.length > 0) { %>
    <div class="lists-grid">
      <% lists.forEach(list => { %>
        <div class="list-card" id="list-card-<%= list.id %>">
          
          <!-- Overlapping Covers Preview -->
          <a href="/list/<%= list.id %>" class="list-covers-preview">
            <div class="covers-stack">
              <% if (list.posters && list.posters.length > 0) { %>
                <% list.posters.forEach(poster => { %>
                  <img src="<%= poster.cover_image %>" alt="<%= poster.title %>" class="cover-thumb" loading="lazy">
                <% }) %>
              <% } else { %>
                <span style="color:var(--muted);font-size:13px;font-weight:600;">No anime yet</span>
              <% } %>
            </div>
          </a>

          <!-- Card Body -->
          <div class="list-card-body">
            <div class="list-card-creator">
              <a href="/u/<%= list.username %>" class="creator-info">
                <% if (list.avatar_url) { %>
                  <img src="<%= list.avatar_url %>" class="creator-avatar" alt="<%= list.username %>">
                <% } else { %>
                  <div class="creator-avatar"><%= list.username.charAt(0).toUpperCase() %></div>
                <% } %>
                <span class="creator-username">by <%= list.username %></span>
              </a>

              <% if (list.is_ranked) { %>
                <span class="badge-ranked">Ranked</span>
              <% } %>
            </div>

            <h2 class="list-card-title">
              <a href="/list/<%= list.id %>"><%= list.title %></a>
            </h2>

            <p class="list-card-desc"><%= list.description || 'Curated community anime collection.' %></p>

            <!-- Social Action Footer -->
            <div class="list-card-footer">
              <div class="card-badges">
                <span class="badge-items"><%= list.item_count %> <%= list.item_count === 1 ? 'anime' : 'anime' %></span>
              </div>

              <div class="card-actions">
                <!-- Like Button -->
                <button class="btn-card-action <%= list.is_liked ? 'liked' : '' %>" onclick="toggleListLike(<%= list.id %>, this)" title="Like list">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="<%= list.is_liked ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                  <span class="action-count"><%= list.like_count || 0 %></span>
                </button>

                <!-- Comments Link -->
                <a href="/list/<%= list.id %>#comments" class="btn-card-action" title="View comments">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                  <span><%= list.comment_count || 0 %></span>
                </a>

                <!-- Save / Bookmark Button -->
                <button class="btn-card-action <%= list.is_saved ? 'saved' : '' %>" onclick="toggleListSave(<%= list.id %>, this)" title="<%= list.is_saved ? 'Saved in favorites' : 'Save list' %>">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="<%= list.is_saved ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
                </button>
              </div>
            </div>

          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="empty-state">
      <p style="font-size: 16px; margin-bottom: 16px; color:#FFFFFF; font-weight:700;">No lists found</p>
      <p style="font-size: 14px; margin-bottom: 24px;">Be the first to curate and share a public list with the community!</p>
      <a href="/list/new" class="btn-create-list">Create a List</a>
    </div>
  <% } %>
</main>

<%- include('partials/footer') %>

<script>
async function toggleListLike(listId, btn) {
  try {
    const res = await fetch('/api/list/' + listId + '/like', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
    const data = await res.json();
    if (data.success) {
      if (data.liked) {
        btn.classList.add('liked');
        btn.querySelector('svg').setAttribute('fill', 'currentColor');
      } else {
        btn.classList.remove('liked');
        btn.querySelector('svg').setAttribute('fill', 'none');
      }
      btn.querySelector('.action-count').textContent = data.likeCount;
    }
  } catch (err) {
    console.error(err);
  }
}

async function toggleListSave(listId, btn) {
  try {
    const res = await fetch('/api/list/' + listId + '/save', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
    const data = await res.json();
    if (data.success) {
      if (data.saved) {
        btn.classList.add('saved');
        btn.querySelector('svg').setAttribute('fill', 'currentColor');
        btn.setAttribute('title', 'Saved in favorites');
      } else {
        btn.classList.remove('saved');
        btn.querySelector('svg').setAttribute('fill', 'none');
        btn.setAttribute('title', 'Save list');
      }
    }
  } catch (err) {
    console.error(err);
  }
}
</script>

</body>
</html>
