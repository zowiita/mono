<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Forgot Password — MÖNO</title>
<link href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,600,700,900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
<style>
body { font-family: "Satoshi", sans-serif; background: #14181C; color: #FFFFFF; min-height: 100vh; display: flex; flex-direction: column; }
.auth-wrap { flex: 1; display: flex; align-items: center; justify-content: center; padding: 40px 20px; }
.auth-box { background: #181D22; border: 1px solid rgba(255,255,255,0.08); padding: 48px; border-radius: 24px; width: 100%; max-width: 420px; box-shadow: 0 12px 40px rgba(0,0,0,0.5); }
.auth-title { font-size: 28px; font-weight: 900; letter-spacing: -0.5px; margin-bottom: 8px; text-align: center; }
.auth-desc { font-size: 14px; color: var(--muted); text-align: center; margin-bottom: 32px; line-height: 1.5; }
.form-group { margin-bottom: 20px; }
.form-label { display: block; font-size: 12px; font-weight: 700; color: #CAD2D9; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 8px; }
.form-input { width: 100%; background: #101215; border: 1px solid rgba(255,255,255,0.12); color: #FFF; padding: 14px 16px; border-radius: 12px; font-size: 15px; outline: none; transition: border-color 0.2s; box-sizing: border-box; }
.form-input:focus { border-color: var(--orange); }
.btn-submit { width: 100%; background: var(--orange); color: #FFF; border: none; padding: 14px; border-radius: 12px; font-size: 15px; font-weight: 700; cursor: pointer; transition: background 0.2s; }
.btn-submit:hover { background: #E54B00; }
.auth-msg { margin-top: 16px; font-size: 13px; text-align: center; color: var(--orange); font-weight: 600; }
.auth-footer { text-align: center; margin-top: 32px; font-size: 14px; color: var(--muted); }
.auth-footer a { color: #FFF; font-weight: 700; text-decoration: none; }
.auth-footer a:hover { color: var(--orange); }
</style>
</head>
<body>
    <%- include('partials/nav') %>
    <main class="auth-wrap">
        <div class="auth-box">
            <h1 class="auth-title">Reset Password</h1>
            <p class="auth-desc">Enter your email address and we'll send you a link to reset your password.</p>
            
            <% if (typeof success !== 'undefined' && success) { %>
                <div style="background: rgba(46, 213, 115, 0.1); border: 1px solid rgba(46, 213, 115, 0.3); color: #2ed573; padding: 12px; border-radius: 8px; font-size: 13px; text-align: center; margin-bottom: 24px;">
                    <%= success %>
                </div>
            <% } %>

            <% if (typeof error !== 'undefined' && error) { %>
                <div style="background: rgba(255, 71, 87, 0.1); border: 1px solid rgba(255, 71, 87, 0.3); color: #ff4757; padding: 12px; border-radius: 8px; font-size: 13px; text-align: center; margin-bottom: 24px;">
                    <%= error %>
                </div>
            <% } %>

            <form action="/forgot-password" method="POST">
                <div class="form-group">
                    <label class="form-label">Email Address</label>
                    <input type="email" name="email" class="form-input" required placeholder="shinji@ikari.com">
                </div>
                <button type="submit" class="btn-submit">Send Reset Link</button>
            </form>
            
            <div class="auth-footer">
                Remember your password? <a href="/login">Sign in</a>
            </div>
        </div>
    </main>
</body>
</html>
