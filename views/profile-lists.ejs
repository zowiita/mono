<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
<title><%= profileUser.username %>'s Lists — Untitled</title>
<link href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,600,700,900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
<style>
:root {
  --bg-main: #14181C;
  --bg-surface: #181D22;
  --bg-card: #1C2228;
  --orange: #FF5500;
  --orange-hover: #E54B00;
  --ink: #FFFFFF;
  --muted: #8C98A4;
  --border-subtle: rgba(255, 255, 255, 0.08);
}

* { box-sizing: border-box; margin: 0; padding: 0; }
body {
  font-family: 'Satoshi', sans-serif;
  background-color: var(--bg-main);
  color: #FFFFFF;
  min-height: 100vh;
}

.wrap {
  max-width: 1100px;
  margin: 40px auto;
  padding: 0 24px;
}

.subnav {
  display: flex;
  gap: 24px;
  border-bottom: 1px solid var(--border-subtle);
  padding-bottom: 14px;
  margin-bottom: 32px;
  flex-wrap: wrap;
}

.subnav a {
  font-size: 15px;
  font-weight: 700;
  color: var(--muted);
  text-decoration: none;
  transition: color 0.15s;
}

.subnav a.active, .subnav a:hover {
  color: #FFFFFF;
}

.header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24px;
  flex-wrap: wrap;
  gap: 16px;
}

.lists-subtabs {
  display: flex;
  align-items: center;
  gap: 20px;
  margin-bottom: 28px;
  border-bottom: 1px solid var(--border-subtle);
  padding-bottom: 10px;
}

.subtab-link {
  font-size: 14px;
  font-weight: 700;
  color: var(--muted);
  text-decoration: none;
  position: relative;
  padding-bottom: 10px;
  transition: color 0.2s;
}

.subtab-link:hover {
  color: #FFFFFF;
}

.subtab-link.active {
  color: #FFFFFF;
}

.subtab-link.active::after {
  content: '';
  position: absolute;
  bottom: -1px;
  left: 0;
  right: 0;
  height: 2px;
  background: var(--orange);
}

.btn-new-list {
  background: var(--orange);
  color: #fff;
  padding: 9px 20px;
  border-radius: 9999px;
  font-size: 13px;
  font-weight: 700;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  box-shadow: 0 4px 14px rgba(255,85,0,0.35);
  transition: transform 0.15s, box-shadow 0.15s, background 0.15s;
}

.btn-new-list:hover {
  transform: translateY(-1px);
  background: var(--orange-hover);
  box-shadow: 0 6px 20px rgba(255,85,0,0.5);
}

.lists-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
  gap: 24px;
}

.list-card {
  background: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 4px 16px rgba(0,0,0,0.4);
  transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
  text-decoration: none;
  color: inherit;
  display: flex;
  flex-direction: column;
}

.list-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 10px 28px rgba(0,0,0,0.6);
  border-color: rgba(255,85,0,0.4);
}

.list-covers-preview {
  height: 130px;
  background: #111418;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10px;
  border-bottom: 1px solid var(--border-subtle);
}

.covers-stack {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  width: 100%;
  height: 100%;
}

.cover-thumb {
  width: 70px;
  height: 100px;
  object-fit: cover;
  border-radius: 6px;
  box-shadow: -4px 0 12px rgba(0,0,0,0.6);
  border: 2px solid rgba(255,255,255,0.12);
  margin-left: -24px;
  transition: transform 0.2s;
  background: #1C2228;
}

.cover-thumb:first-child {
  margin-left: 0;
}

.list-card:hover .cover-thumb {
  transform: translateY(-3px);
}

.list-card-body {
  padding: 18px;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.list-creator-tag {
  font-size: 12px;
  color: var(--muted);
  margin-bottom: 6px;
  font-weight: 600;
}

.list-title {
  font-size: 17px;
  font-weight: 800;
  color: #FFFFFF;
  margin-bottom: 6px;
  line-height: 1.35;
}

.list-desc {
  font-size: 13px;
  color: #CAD2D9;
  line-height: 1.5;
  margin-bottom: 16px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  flex: 1;
}

.list-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 12px;
  font-weight: 700;
  color: var(--muted);
  border-top: 1px solid var(--border-subtle);
  padding-top: 12px;
}

.footer-stats {
  display: flex;
  align-items: center;
  gap: 12px;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 4px;
}
</style>
</head>
<body>
    <%- include('partials/nav') %>

    <div class="wrap">
        <div class="subnav">
            <a href="/u/<%= profileUser.username %>">Profile</a>
            <a href="/u/<%= profileUser.username %>/anime">Anime</a>
            <a href="/u/<%= profileUser.username %>/diary">Diary</a>
            <a href="/u/<%= profileUser.username %>/watchlist">Watchlist</a>
            <a href="/u/<%= profileUser.username %>/lists" class="active">Lists (<%= (createdLists ? createdLists.length : 0) + (savedLists ? savedLists.length : 0) %>)</a>
            <a href="/u/<%= profileUser.username %>/reviews">Reviews</a>
            <a href="/u/<%= profileUser.username %>/stats">Stats</a>
        </div>

        <div class="header-row">
            <h1 style="font-size:26px; font-weight:900;"><%= profileUser.username %>'s Lists</h1>
            <a href="/list/new" class="btn-new-list">+ Start a new list</a>
        </div>

        <!-- Created vs Saved Lists Subtabs -->
        <div class="lists-subtabs">
          <a href="/u/<%= profileUser.username %>/lists?tab=created" class="subtab-link <%= activeTab === 'created' ? 'active' : '' %>">
            Created Lists (<%= createdLists ? createdLists.length : 0 %>)
          </a>
          <a href="/u/<%= profileUser.username %>/lists?tab=saved" class="subtab-link <%= activeTab === 'saved' ? 'active' : '' %>">
            Saved to Favorites (<%= savedLists ? savedLists.length : 0 %>)
          </a>
        </div>

        <% const displayLists = activeTab === 'saved' ? savedLists : createdLists; %>

        <div class="lists-grid">
            <% if (displayLists && displayLists.length > 0) { %>
                <% displayLists.forEach(l => { %>
                    <a href="/list/<%= l.id %>" class="list-card">
                        <div class="list-covers-preview">
                          <div class="covers-stack">
                            <% if (l.posters && l.posters.length > 0) { %>
                              <% l.posters.forEach(poster => { %>
                                <img src="<%= poster.cover_image %>" alt="<%= poster.title %>" class="cover-thumb" loading="lazy">
                              <% }) %>
                            <% } else { %>
                              <span style="color:var(--muted);font-size:12px;">No anime yet</span>
                            <% } %>
                          </div>
                        </div>

                        <div class="list-card-body">
                          <% if (activeTab === 'saved' && l.creator_username) { %>
                            <div class="list-creator-tag">by <%= l.creator_username %></div>
                          <% } %>
                          <div class="list-title"><%= l.title %></div>
                          <% if (l.description) { %>
                              <div class="list-desc"><%= l.description %></div>
                          <% } %>
                          <div class="list-footer">
                              <span><%= l.item_count || 0 %> anime</span>
                              <div class="footer-stats">
                                <span class="stat-item">
                                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                                  <%= l.like_count || 0 %>
                                </span>
                                <span class="stat-item">
                                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                                  <%= l.comment_count || 0 %>
                                </span>
                              </div>
                          </div>
                        </div>
                    </a>
                <% }); %>
            <% } else { %>
                <div style="grid-column: 1 / -1; padding:48px; text-align:center; color:var(--muted); background:var(--bg-surface); border:1px solid var(--border-subtle); border-radius:12px;">
                    <%= activeTab === 'saved' ? 'No saved lists yet. Browse the community directory to bookmark lists you love!' : 'No lists created yet.' %> <br><br>
                    <% if (activeTab === 'saved') { %>
                      <a href="/lists" class="btn-new-list" style="display:inline-flex;">Explore Community Lists</a>
                    <% } else { %>
                      <a href="/list/new" class="btn-new-list" style="display:inline-flex;">+ Create your first list</a>
                    <% } %>
                </div>
            <% } %>
        </div>
    </div>

    <%- include('partials/footer') %>
</body>
</html>