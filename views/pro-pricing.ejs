          <td>✓</td>
        </tr>
      </tbody>
    </table>
  </div>
</main>

<%- include('partials/footer') %>

<script>
async function activateTier(tier) {
  try {
    const res = await fetch('/api/user/toggle-pro', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ tier })
    });
    const data = await res.json();
    if (data.success) {
      alert(data.message);
      window.location.href = '/u/zowi/stats';
    }
  } catch (err) {
    console.error(err);
  }
}
</script>

</body>
</html>
