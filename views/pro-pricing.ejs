<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Möno Pro & Patron Memberships — Supercharge Your Anime Life</title>
<link rel="preconnect" href="https://api.fontshare.com">
<link href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,600,700,900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
<style>
:root {
  --bg-main: #14181C;
  --bg-surface: #181D22;
  --bg-card: #1C2228;
  --orange: #FF5500;
  --orange-hover: #E54B00;
  --gold: #FFB800;
  --purple: #00B4D8;
  --ink: #FFFFFF;
  --muted: #8C98A4;
  --border-subtle: rgba(255, 255, 255, 0.08);
}

* { box-sizing: border-box; margin: 0; padding: 0; }
body {
  font-family: 'Satoshi', sans-serif;
  background-color: var(--bg-main);
  color: #FFFFFF;
  min-height: 100vh;
}

.wrap {
  max-width: 1080px;
  margin: 0 auto;
  padding: 60px 24px 80px;
}

.hero-section {
  text-align: center;
  max-width: 680px;
  margin: 0 auto 56px;
}

.hero-tag {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: rgba(255, 85, 0, 0.12);
  color: var(--orange);
  border: 1px solid rgba(255, 85, 0, 0.3);
  padding: 6px 14px;
  border-radius: 9999px;
  font-size: 12px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-bottom: 16px;
}

.hero-title {
  font-size: 42px;
  font-weight: 900;
  letter-spacing: -1px;
  line-height: 1.15;
  margin-bottom: 16px;
}

.hero-desc {
  font-size: 17px;
  color: #CAD2D9;
  line-height: 1.6;
}

/* Pricing Grid */
.pricing-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 24px;
  margin-bottom: 64px;
}

.pricing-card {
  background: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  border-radius: 20px;
  padding: 32px 28px;
  display: flex;
  flex-direction: column;
  position: relative;
  transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
}

.pricing-card:hover {
  transform: translateY(-4px);
  border-color: rgba(255, 255, 255, 0.2);
  box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5);
}

.pricing-card.featured {
  background: linear-gradient(180deg, #1C2228 0%, #181D22 100%);
  border: 2px solid var(--orange);
  box-shadow: 0 12px 36px rgba(255, 85, 0, 0.2);
}

.card-badge {
  position: absolute;
  top: -12px;
  left: 50%;
  transform: translateX(-50%);
  background: var(--orange);
  color: #fff;
  font-size: 11px;
  font-weight: 900;
  padding: 4px 14px;
  border-radius: 9999px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.tier-name {
  font-size: 22px;
  font-weight: 900;
  margin-bottom: 8px;
}

.tier-price-row {
  display: flex;
  align-items: baseline;
  gap: 6px;
  margin-bottom: 12px;
}

.tier-price {
  font-size: 40px;
  font-weight: 900;
  color: #FFFFFF;
}

.tier-period {
  font-size: 14px;
  color: var(--muted);
}

.tier-desc {
  font-size: 13px;
  color: #CAD2D9;
  line-height: 1.5;
  margin-bottom: 24px;
  min-height: 40px;
}

.feature-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 14px;
  margin-bottom: 32px;
  flex: 1;
}

.feature-item {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  font-size: 14px;
  color: #CAD2D9;
  line-height: 1.4;
}

.feature-icon {
  color: var(--orange);
  flex-shrink: 0;
  margin-top: 2px;
}

.btn-tier {
  width: 100%;
  padding: 13px;
  border-radius: 9999px;
  font-size: 14px;
  font-weight: 800;
  font-family: inherit;
  cursor: pointer;
  text-align: center;
  text-decoration: none;
  transition: all 0.2s;
  border: 1px solid var(--border-subtle);
  background: rgba(255, 255, 255, 0.06);
  color: #FFFFFF;
}

.btn-tier:hover {
  background: rgba(255, 255, 255, 0.12);
  border-color: rgba(255, 255, 255, 0.3);
}

.btn-tier-primary {
  background: var(--orange);
  border-color: var(--orange);
  color: #fff;
  box-shadow: 0 4px 16px rgba(255, 85, 0, 0.35);
}

.btn-tier-primary:hover {
  background: var(--orange-hover);
  border-color: var(--orange-hover);
  transform: translateY(-1px);
}

.btn-tier-patron {
  background: linear-gradient(135deg, #00B4D8, #6A56E8);
  border-color: #00B4D8;
  color: #fff;
  box-shadow: 0 4px 16px rgba(139, 124, 255, 0.35);
}

.btn-tier-patron:hover {
  filter: brightness(1.1);
  transform: translateY(-1px);
}

/* Comparison Table */
.comparison-section {
  margin-top: 48px;
}

.comparison-table {
  width: 100%;
  border-collapse: collapse;
  margin-top: 24px;
}

.comparison-table th, .comparison-table td {
  padding: 16px 20px;
  border-bottom: 1px solid var(--border-subtle);
  text-align: left;
  font-size: 14px;
}

.comparison-table th {
  font-size: 13px;
  font-weight: 900;
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.comparison-table td:not(:first-child), .comparison-table th:not(:first-child) {
  text-align: center;
}
</style>
</head>
<body>

<%- include('partials/nav') %>

<main class="wrap">
  <div class="hero-section">
