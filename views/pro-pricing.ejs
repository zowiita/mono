        <div style="background:#181D22; border:1px solid rgba(255,255,255,0.08); border-radius:16px; padding:36px 28px; display:flex; flex-direction:column; justify-between;">
            <div>
                <div style="font-size:12px; font-weight:800; text-transform:uppercase; letter-spacing:1px; color:var(--muted); margin-bottom:8px;">FREE PLAN</div>
