        </div>

        <!-- PRO TIER CARD ($3/MO OR $28/YR) -->
        <div style="background:#1C2228; border:1px solid var(--orange); border-radius:16px; padding:36px 28px; display:flex; flex-direction:column; justify-between; position:relative; box-shadow:0 12px 40px rgba(255,85,0,0.25);">
            <div style="position:absolute; top:-14px; right:24px; background:var(--orange); color:#FFF; font-size:10px; font-weight:900; text-transform:uppercase; padding:4px 12px; border-radius:12px; letter-spacing:1px;">RECOMMENDED</div>
            <div>
                <div style="font-size:12px; font-weight:800; text-transform:uppercase; letter-spacing:1px; color:var(--orange); margin-bottom:8px;">PRO PLAN</div>
                <h3 style="font-size:28px; font-weight:900; color:#FFF; margin-bottom:12px;">Möno Pro</h3>
                <div style="font-size:36px; font-weight:900; color:#FFF; margin-bottom:4px;">$3 <span style="font-size:14px; color:var(--muted); font-weight:500;">/ month</span></div>
                <div style="font-size:12.5px; font-weight:700; color:var(--orange); margin-bottom:16px;">or $28 / year (Save 22%)</div>
                <p style="font-size:14px; color:#9E9E9E; line-height:1.6; margin-bottom:28px;">Unlock deep lifetime analytics, rating distribution charts, Pro badges, and supporter perks.</p>
                <div style="display:flex; flex-direction:column; gap:12px; font-size:13.5px; color:#FFFFFF;">
                    <div>✦ <strong>Lifetime Stats & Analytics</strong> (Exclusive)</div>
                    <div>✦ Rating Distribution Histogram Charts</div>
                    <div>✦ Custom Pro Badge & Profile Glow</div>
                    <div>✦ Möno Wrapped Year-in-Review</div>
                    <div>✦ Early Access & Supporter Badge</div>
                </div>
            </div>
            <a href="/settings" style="display:block; width:100%; text-align:center; padding:13px 0; border-radius:24px; background:var(--orange); color:#FFF; font-weight:800; text-decoration:none; margin-top:32px; box-shadow:0 6px 20px rgba(255,85,0,0.4);">Upgrade to Möno Pro →</a>
        </div>

    </div>

  <!-- Comparison Section -->
  <div class="comparison-section">
    <h2 style="font-size:24px; font-weight:900; margin-bottom:12px;">Full Feature Comparison</h2>
    <table class="comparison-table">
      <thead>
        <tr>
          <th>Features</th>
